{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/identity/identity_vectors_v1.schema.json",
  "title": "Identity Vectors v1",
  "description": "Structure of traigent_schema/data/identity/identity_vectors_v1.json: cross-SDK identity test vectors (registration identity and provenance, trace attribution, environment resolution).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "description", "sources", "closed_sets", "notes", "provenance", "trace_attribution", "environment"],
  "properties": {
    "contract": {"const": "identity_vectors"},
    "version": {"const": 1},
    "description": {"type": "string"},
    "sources": {"type": "object", "additionalProperties": {"type": "string"}},
    "closed_sets": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/ProvenanceVector"}},
    "trace_attribution": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/AttributionVector"}},
    "environment": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/EnvironmentVector"}}
  },
  "definitions": {
    "Id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "Rule": {"enum": ["attribution.late_after_record", "attribution.legacy_trace_level", "attribution.native.conflict", "attribution.native.enclosing", "attribution.native.neutral_root", "attribution.native.no_scopes", "attribution.native.not_finalized", "attribution.native.open_scope", "attribution.native.sealed_taint", "attribution.native.unanimous", "attribution.otlp.delivery_order", "attribution.otlp.strict", "attribution.otlp.unreadable_metadata", "attribution.snapshot.early_ignored", "attribution.snapshot.final_identity", "attribution.snapshot.final_without_identity", "attribution.snapshot.persisted_end_not_enough", "attribution.snapshot.stale_early_erases", "environment.env_var_known_only", "environment.explicit_free_label", "environment.never_infer", "environment.order", "provenance.anonymous_ineligible", "provenance.function_derived", "provenance.manifest_mismatch", "provenance.unsupported_callable", "provenance.user_named"]},
    "Provenance": {"enum": ["function_derived", "user_named", "ineligible"]},
    "Reason": {"enum": ["attributed", "conflict", "ineligible", "open_scope", "incomplete", "evidence_unavailable"]},
    "ProvenanceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "rule", "anchor", "input", "expected"],
      "properties": {
        "id": {"$ref": "#/definitions/Id"},
        "description": {"type": "string"},
        "rule": {"$ref": "#/definitions/Rule"},
        "anchor": {"const": "consumer"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sdk"],
          "properties": {
            "sdk": {"enum": ["python", "js"]},
            "function_name": {"type": ["string", "null"]},
            "qualname": {"type": ["string", "null"]},
            "agent_name": {"type": ["string", "null"]},
            "experiment_name_env": {"type": ["string", "null"]},
            "manifest_agent_id": {"type": ["string", "null"]},
            "objectives": {"type": ["array", "null"], "items": {"type": "string"}},
            "knobs": {"type": ["array", "null"], "items": {"type": "string"}}
          }
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["registration_identity", "provenance", "trace_agent_id", "local_warning"],
              "properties": {
                "registration_identity": {"type": ["string", "null"]},
                "provenance": {"$ref": "#/definitions/Provenance"},
                "trace_agent_id": {"type": ["string", "null"]},
                "local_warning": {"enum": [null, "manifest_registration_mismatch", "anonymous_registration"]},
                "backend_agent_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "error", "trace_agent_id"],
              "properties": {
                "outcome": {"const": "unsupported"},
                "error": {"enum": ["not_decoratable"]},
                "trace_agent_id": {"type": "null"}
              }
            }
          ]
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "parent", "key", "provenance", "state_at_finalization"],
      "properties": {
        "scope_id": {"type": "string"},
        "parent": {"type": ["string", "null"]},
        "key": {"type": ["string", "null"]},
        "provenance": {"$ref": "#/definitions/Provenance"},
        "state_at_finalization": {"enum": ["open", "closed"]}
      }
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "agent_id"],
      "properties": {"span_id": {"type": "string"}, "agent_id": {"type": ["string", "null"]}}
    },
    "Delivery": {"type": "array", "items": {"$ref": "#/definitions/Span"}},
    "AttributionVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "rule", "anchor", "input", "expected"],
      "properties": {
        "id": {"$ref": "#/definitions/Id"},
        "description": {"type": "string"},
        "rule": {"$ref": "#/definitions/Rule"},
        "anchor": {"const": "consumer"},
        "input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "scopes", "early_flush_before_finalization", "final_snapshot_delivered"],
              "properties": {
                "transport": {"const": "native"},
                "scopes": {"type": "array", "items": {"$ref": "#/definitions/Scope"}},
                "early_flush_before_finalization": {"type": "boolean"},
                "final_snapshot_delivered": {"type": "boolean"},
                "legacy_trace_level_agent_id": {"type": "string"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "snapshots", "persisted_ended_at_present"],
              "properties": {
                "transport": {"const": "native"},
                "persisted_ended_at_present": {"type": "boolean"},
                "snapshots": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["seq", "has_incoming_end_time", "agent_id"],
                    "properties": {
                      "seq": {"type": "integer", "minimum": 1},
                      "has_incoming_end_time": {"type": "boolean"},
                      "agent_id": {"type": ["string", "null"]}
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "deliveries", "metadata_readable"],
              "properties": {
                "transport": {"const": "otlp"},
                "deliveries": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/Delivery"}},
                "metadata_readable": {"type": "boolean"},
                "same_result_as": {"type": "string"},
                "window_recorded": {"type": "boolean"},
                "late_deliveries": {"type": "array", "items": {"$ref": "#/definitions/Delivery"}}
              }
            }
          ]
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attributed_to", "reason"],
          "properties": {
            "attributed_to": {"type": ["string", "null"]},
            "reason": {"$ref": "#/definitions/Reason"},
            "late_after_record": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "EnvironmentVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "rule", "anchor", "input", "expected"],
      "properties": {
        "id": {"$ref": "#/definitions/Id"},
        "description": {"type": "string"},
        "rule": {"$ref": "#/definitions/Rule"},
        "anchor": {"const": "consumer"},
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": {
            "explicit": {"type": "string"},
            "env": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "environment", "source", "warning"],
          "properties": {
            "valid": {"type": "boolean"},
            "environment": {"type": ["string", "null"], "maxLength": 64},
            "source": {"enum": [null, "explicit", "traigent_environment", "otel_resource", "environment", "traigent_env_legacy", "default"]},
            "warning": {"enum": [null, "legacy_env_var_deprecated", "undeclared_default", "invalid_env_value_ignored"]},
            "error": {"enum": ["too_long"]}
          }
        }
      }
    }
  }
}
