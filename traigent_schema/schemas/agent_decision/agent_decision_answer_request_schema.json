{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/agent_decision/agent_decision_answer_request_schema.json",
  "title": "Agent Decision Answer Request",
  "description": "Body of POST /api/v1beta/agent-decisions/{decision_id}/answer. Closed answer plus the server-issued versions, digest and nonce echoed back; no free text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "options_version",
    "policy_version",
    "basis_digest",
    "retry_nonce"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "enum": [
        "YES",
        "NOT_NOW"
      ],
      "x-content-class": "closed_enum"
    },
    "options_version": {
      "type": "string",
      "pattern": "^[0-9]{1,4}$",
      "maxLength": 4,
      "x-content-class": "closed_enum",
      "enum": [
        "1"
      ]
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]{1,4}$",
      "maxLength": 4,
      "x-content-class": "closed_enum",
      "enum": [
        "1"
      ]
    },
    "basis_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71,
      "x-content-class": "digest"
    },
    "retry_nonce": {
      "type": "string",
      "pattern": "^rn_[0-9a-f]{32}$",
      "maxLength": 35,
      "x-content-class": "opaque_ref",
      "description": "CLIENT-generated, fresh for each answer attempt, and reused only to retry that same attempt. The server stores only a keyed digest of it."
    }
  }
}
