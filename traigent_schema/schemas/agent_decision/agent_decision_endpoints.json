{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Agent Decision (host-prompt) Routes",
    "version": "1.0.0",
    "description": "Closed host-prompt decision requests: the backend issues a closed question about an agent; the customer's coding agent asks the human in its own UI and posts back a closed answer. No customer content crosses this channel."
  },
  "paths": {
    "/api/v1beta/agent-decisions/{agent_id}/ensure": {
      "post": {
        "summary": "Ensure an open decision for an agent",
        "description": "Requires project role editor. Idempotent per (agent, kind, basis): concurrent ensures return the same OPEN decision. 200 `decision: null` means no question applies for the current basis (already answered for this basis, or nothing to ask right now); no new decision is created after a YES or NOT_NOW for the same basis. Exception for recovery: if the latest decision for the current basis is ANSWERED YES with execution_status FAILED, ensure may issue a new OPEN decision. To resume after an answer (execution_ref, next_action), call latest. Status mapping: 401 UNAUTHENTICATED, 403 FORBIDDEN, 404 AGENT_NOT_FOUND, 409 NOT_ELIGIBLE (the agent is not eligible for this kind at all), 422 INVALID_REQUEST, 429 RATE_LIMITED, 503 POLICY_UNAVAILABLE.",
        "operationId": "ensureAgentDecision",
        "x-asserted-against-backend": false,
        "x-required-permission": "experiment.write",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "description": "The customer's own agent id, sent only in the request path as every agent endpoint does. It is never echoed in any response or error and never stored outside the agent foreign key.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./agent_decision_ensure_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The OPEN decision for this basis, or null when none applies now.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_ensure_response_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: project role or permission (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "AGENT_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "409": {
            "description": "NOT_ELIGIBLE: the agent is not eligible for this kind at all.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_REQUEST (malformed body, unknown fields, out-of-domain values).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (RATE_LIMITED, with retry_after_seconds).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_rate_limited_error_schema.json"
                }
              }
            }
          },
          "503": {
            "description": "POLICY_UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1beta/agent-decisions/{agent_id}/latest": {
      "get": {
        "summary": "Get the latest decision for an agent",
        "description": "Read-only. Returns the latest decision in any status, or null. Requires project role viewer. 404 AGENT_NOT_FOUND. Use it to resume after an answer: it carries execution_ref and next_action.",
        "operationId": "getLatestAgentDecision",
        "x-asserted-against-backend": false,
        "x-required-permission": "experiment.read",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "description": "The customer's own agent id, sent only in the request path as every agent endpoint does. It is never echoed in any response or error and never stored outside the agent foreign key.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The latest decision in any status, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_latest_response_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: project role or permission (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "AGENT_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (RATE_LIMITED, with retry_after_seconds).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_rate_limited_error_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1beta/agent-decisions/{decision_id}/answer": {
      "post": {
        "summary": "Answer a decision",
        "description": "Requires project role editor. Status mapping: 401 UNAUTHENTICATED, 403 FORBIDDEN, 404 DECISION_NOT_FOUND, 409 (DECISION_ALREADY_ANSWERED, REPLAY_MISMATCH, DECISION_SUPERSEDED, STALE_BASIS, VERSION_MISMATCH, NOT_ELIGIBLE), 410 DECISION_EXPIRED, 422 INVALID_REQUEST, 429 RATE_LIMITED, 503 POLICY_UNAVAILABLE. Retry semantics. retry_nonce is client-generated, fresh per answer attempt, reused only to retry that same attempt; the server stores only a keyed digest of it. Scope: the authenticated tenant + project + decision. Order: (1) authenticate and authorize (401/403); (2) if the decision is ANSWERED and the stored attempt matches (same principal AND same nonce AND same body): 200 replay of the current object, also after expiry or after execution started; (3) same principal + same nonce + different body: 409 REPLAY_MISMATCH; (4) decision ANSWERED by any other attempt: 409 DECISION_ALREADY_ANSWERED; (5) then state checks: EXPIRED 410 DECISION_EXPIRED; SUPERSEDED 409 DECISION_SUPERSEDED; basis or version mismatch 409 STALE_BASIS / VERSION_MISMATCH; no longer eligible 409 NOT_ELIGIBLE; policy evidence unavailable 503 POLICY_UNAVAILABLE. Malformed or out-of-domain bodies are 422 INVALID_REQUEST. Recording the answer is atomic.",
        "operationId": "answerAgentDecision",
        "x-asserted-against-backend": false,
        "x-required-permission": "experiment.write",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "description": "Server-issued decision id (dr_<32 hex>).",
            "schema": {
              "type": "string",
              "maxLength": 35,
              "pattern": "^dr_[0-9a-f]{32}$",
              "x-content-class": "opaque_ref"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./agent_decision_answer_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The ANSWERED decision (also on an idempotent replay).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_answer_response_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated (UNAUTHENTICATED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: project role or permission (FORBIDDEN).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "DECISION_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "409": {
            "description": "DECISION_ALREADY_ANSWERED, REPLAY_MISMATCH, DECISION_SUPERSEDED, STALE_BASIS, VERSION_MISMATCH or NOT_ELIGIBLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "410": {
            "description": "DECISION_EXPIRED.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "422": {
            "description": "INVALID_REQUEST (malformed body, unknown fields, out-of-domain values).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (RATE_LIMITED, with retry_after_seconds).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_rate_limited_error_schema.json"
                }
              }
            }
          },
          "503": {
            "description": "POLICY_UNAVAILABLE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_decision_error_schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
