{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/agent_decision/agent_decision_response_schema.json",
  "title": "Agent Decision Response",
  "description": "Envelope for a decision. decision is null when no decision applies now.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "oneOf": [
        {
          "$ref": "./agent_decision_schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
