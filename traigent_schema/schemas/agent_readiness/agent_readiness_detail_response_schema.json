{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/agent_readiness/agent_readiness_detail_response_schema.json",
  "title": "Agent Readiness Detail Response",
  "description": "Content-free Agent detail with a paginated experiment journey and narrow evidence checks. A top-level anchor may be populated even when the requested journey page contains no anchor item.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "format": "date-time"},
    "agent": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/AgentSummary"},
    "anchor_run_id": {
      "oneOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        {"type": "null"}
      ]
    },
    "anchor_experiment_id": {
      "oneOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        {"type": "null"}
      ]
    },
    "next_action_experiment_id": {
      "oneOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        {"type": "null"}
      ]
    },
    "next_action_run_id": {
      "oneOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        {"type": "null"}
      ]
    },
    "anchor_completed_at": {
      "oneOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "agent_updated_after_anchor": {"type": "boolean"},
    "pillars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {"$ref": "#/definitions/AgentPillarDetail"},
        "evaluator": {"$ref": "#/definitions/EvaluatorPillarDetail"},
        "evaluation_dataset": {"$ref": "#/definitions/DatasetPillarDetail"}
      },
      "required": ["agent", "evaluator", "evaluation_dataset"]
    },
    "process_assurance": {"$ref": "#/definitions/ProcessAssurance"},
    "evaluation_system_validity": {
      "$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvaluationSystemValidity"
    },
    "agent_posture": {
      "description": "E4: the Agent's current manager-set posture (deployment stage and criticality), or NONE_DECLARED. Optional for rollout: becomes required once TraigentBackend emits it (follow-up), so unrelated Backend schema-pin bumps keep validating today's bodies. Closed and validated whenever present.",
      "$ref": "https://schemas.traigent.ai/agent_readiness/agent_posture_schema.json#/definitions/AgentPosture"
    },
    "team_requirement": {
      "description": "The team latency target chain.",
      "oneOf": [
        {"$ref": "./agent_readiness_target_schema.json#/definitions/NoTarget"},
        {"$ref": "./agent_readiness_target_schema.json#/definitions/DeclaredLatencyTarget"}
      ]
    },
    "team_accuracy_requirement": {
      "description": "E5: the team accuracy target chain, independent of the latency chain in team_requirement. Optional for rollout: becomes required once TraigentBackend emits it (follow-up). Closed and validated whenever present.",
      "oneOf": [
        {"$ref": "./agent_readiness_target_schema.json#/definitions/NoTarget"},
        {"$ref": "./agent_readiness_target_schema.json#/definitions/DeclaredAccuracyTarget"}
      ]
    },
    "current_context": {"$ref": "#/definitions/CurrentContext"},
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/definitions/JourneyItem"}
        },
        "pagination": {
          "allOf": [
            {"$ref": "../pagination_schema.json"},
            {"properties": {"per_page": {"maximum": 50}}}
          ]
        }
      },
      "required": ["items", "pagination"]
    },
    "anchor_summary": {
      "oneOf": [
        {"$ref": "#/definitions/JourneyItem"},
        {"type": "null"}
      ]
    },
    "next_action_code": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/NextActionCode"}
  },
  "required": [
    "schema_version",
    "as_of",
    "agent",
    "anchor_run_id",
    "anchor_experiment_id",
    "anchor_completed_at",
    "next_action_experiment_id",
    "next_action_run_id",
    "agent_updated_after_anchor",
    "pillars",
    "process_assurance",
    "evaluation_system_validity",
    "team_requirement",
    "current_context",
    "journey",
    "anchor_summary",
    "next_action_code"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "process_assurance": {
              "properties": {
                "stage": {"enum": ["NO_RUNS", "RUNS_RECORDED"]}
              }
            },
            "anchor_run_id": {"type": "null"},
            "anchor_experiment_id": {"type": "null"},
            "anchor_completed_at": {"type": "null"}
          }
        },
        {
          "properties": {
            "process_assurance": {
              "properties": {
                "stage": {"const": "EVALUATION_COMPLETED"}
              }
            },
            "anchor_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
            "anchor_experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
            "anchor_completed_at": {
              "oneOf": [
                {"type": "string", "format": "date-time"},
                {"type": "null"}
              ]
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {"properties": {"anchor_run_id": {"type": "null"}, "anchor_summary": {"type": "null"}}},
        {
          "properties": {
            "anchor_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
            "anchor_summary": {
              "allOf": [
                {"$ref": "#/definitions/JourneyItem"},
                {"properties": {"is_anchor": {"const": true}, "status": {"const": "COMPLETED"}}, "required": ["is_anchor", "status"]}
              ]
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {"properties": {"next_action_code": {"const": "ESTABLISH_BASELINE_EVALUATION"}, "next_action_experiment_id": {"type": "null"}, "next_action_run_id": {"type": "null"}}},
        {"properties": {"next_action_code": {"const": "COMPLETE_EVALUATION_RUN"}, "next_action_experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}, "next_action_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}}},
        {"properties": {"next_action_code": {"const": "COMPLETE_EVALUATION_RUN"}, "next_action_experiment_id": {"type": "null"}, "next_action_run_id": {"type": "null"}}},
        {"properties": {"next_action_code": {"enum": ["EVALUATE_DATASET_EXAMPLES", "RECORD_ACCURACY_MEASURE", "REVIEW_RECORDED_EVIDENCE"]}, "next_action_experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}, "next_action_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}}}
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "anchor_run_id": {"type": "null"},
            "anchor_experiment_id": {"type": "null"},
            "anchor_completed_at": {"type": "null"},
            "journey": {
              "properties": {
                "items": {
                  "not": {
                    "contains": {
                      "properties": {"is_anchor": {"const": true}}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "anchor_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}
          }
        }
      ]
    },
    {
      "if": {"properties": {"anchor_completed_at": {"type": "null"}}},
      "then": {"properties": {"agent_updated_after_anchor": {"const": false}}}
    },
    {
      "oneOf": [
        {
          "properties": {
            "anchor_run_id": {"type": "null"},
            "pillars": {
              "properties": {
                "agent": {
                  "properties": {
                    "checks": {
                      "items": [
                        {},
                        {"$ref": "#/definitions/GapOrUnknownCheckState"},
                        {"$ref": "#/definitions/UnknownCheckState"},
                        {"$ref": "#/definitions/UnknownCheckState"}
                      ]
                    }
                  }
                },
                "evaluator": {
                  "properties": {
                    "checks": {
                      "items": [
                        {"$ref": "#/definitions/UnknownCheckState"},
                        {},
                        {}
                      ]
                    }
                  }
                },
                "evaluation_dataset": {
                  "properties": {
                    "checks": {
                      "items": [
                        {"$ref": "#/definitions/UnknownCheckState"},
                        {"$ref": "#/definitions/UnknownCheckState"},
                        {"$ref": "#/definitions/UnknownCheckState"}
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "anchor_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
            "pillars": {
              "properties": {
                "agent": {
                  "properties": {
                    "checks": {
                      "items": [
                        {},
                        {"$ref": "#/definitions/SupportedCheckState"}
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "process_assurance": {
              "properties": {
                "stage": {"const": "NO_RUNS"},
                "checks": {
                  "items": [{"$ref": "#/definitions/UnknownCheckState"}]
                }
              }
            },
            "pillars": {
              "properties": {
                "agent": {
                  "properties": {
                    "checks": {
                      "items": [
                        {},
                        {"$ref": "#/definitions/UnknownCheckState"}
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "process_assurance": {
              "properties": {
                "stage": {"const": "RUNS_RECORDED"},
                "checks": {
                  "items": [{"$ref": "#/definitions/SupportedCheckState"}]
                }
              }
            },
            "pillars": {
              "properties": {
                "agent": {
                  "properties": {
                    "checks": {
                      "items": [
                        {},
                        {"properties": {"state": {"const": "GAP"}}}
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "process_assurance": {
              "properties": {"stage": {"const": "EVALUATION_COMPLETED"}}
            }
          }
        }
      ]
    }
  ],
  "definitions": {
    "AgentPillarDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_state": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageState"},
        "checks": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": [
            {"$ref": "#/definitions/AgentRecordAvailableCheck"},
            {"$ref": "#/definitions/CompletedEvaluationRunCheck"},
            {"$ref": "#/definitions/AccuracyMeasureRecordedCheck"},
            {"$ref": "#/definitions/UnitBearingEfficiencyMeasureRecordedCheck"}
          ],
          "additionalItems": false
        }
      },
      "required": ["coverage_state", "checks"],
      "allOf": [{"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageFromChecks"}]
    },
    "EvaluatorPillarDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_state": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageState"},
        "checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {"$ref": "#/definitions/EvaluatorVersionSnapshotRecordedCheck"},
            {"$ref": "#/definitions/EvaluatorExecutionLinkAssessedCheck"},
            {"$ref": "#/definitions/EvaluatorStabilityAssessedCheck"}
          ],
          "additionalItems": false
        }
      },
      "required": ["coverage_state", "checks"],
      "allOf": [{"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageFromChecks"}]
    },
    "DatasetPillarDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_state": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageState"},
        "checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {"$ref": "#/definitions/RunDatasetIdentityRecordedCheck"},
            {"$ref": "#/definitions/EvaluatedExampleCountRecordedCheck"},
            {"$ref": "#/definitions/DatasetQualityAssessmentRecordedCheck"}
          ],
          "additionalItems": false
        }
      },
      "required": ["coverage_state", "checks"],
      "allOf": [{"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageFromChecks"}]
    },
    "ProcessAssurance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_state": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageState"},
        "stage": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/ProcessStage"},
        "checks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {"$ref": "#/definitions/ExperimentPathRecordedCheck"},
            {"$ref": "#/definitions/SelectedConfigurationRecordedCheck"},
            {"$ref": "#/definitions/SelectionLedgerMatchAssessedCheck"}
          ],
          "additionalItems": false
        },
        "certificate_match": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CertificateMatch"}
      },
      "required": ["coverage_state", "stage", "checks", "certificate_match"],
      "allOf": [{"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageFromChecks"}]
    },
    "AgentEvidenceRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "agent"}}}
      ]
    },
    "ExperimentEvidenceRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "experiment"}}}
      ]
    },
    "ExperimentRunEvidenceRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "experiment_run"}}}
      ]
    },
    "ConfigurationRunEvidenceRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "configuration_run"}}}
      ]
    },
    "EvaluationDatasetRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "evaluation_dataset"}}}
      ]
    },
    "EvaluatorVersionRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "evaluator_version"}}}
      ]
    },
    "DatasetQualityEvidenceRef": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceRef"},
        {"properties": {"kind": {"const": "dataset_quality"}}}
      ]
    },
    "SupportedBackendAgentCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "backend_observed"}, "evidence_ref": {"$ref": "#/definitions/AgentEvidenceRef"}}}
      ]
    },
    "SupportedBackendExperimentRunCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "backend_observed"}, "evidence_ref": {"$ref": "#/definitions/ExperimentRunEvidenceRef"}}}
      ]
    },
    "SupportedClientConfigurationRunCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "client_reported"}, "evidence_ref": {"$ref": "#/definitions/ConfigurationRunEvidenceRef"}}}
      ]
    },
    "SupportedServerEvaluatorVersionCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "server_recorded_client_declaration"}, "evidence_ref": {"$ref": "#/definitions/EvaluatorVersionRef"}}}
      ]
    },
    "SupportedServerEvaluationDatasetCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "server_recorded_client_declaration"}, "evidence_ref": {"$ref": "#/definitions/EvaluationDatasetRef"}}}
      ]
    },
    "SupportedBackendDatasetQualityCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "backend_observed"}, "evidence_ref": {"$ref": "#/definitions/DatasetQualityEvidenceRef"}}}
      ]
    },
    "SupportedBackendExperimentCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "SUPPORTED"}, "observation_basis": {"const": "backend_observed"}, "evidence_ref": {"$ref": "#/definitions/ExperimentEvidenceRef"}}}
      ]
    },
    "GapBackendAgentCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "GAP"}, "observation_basis": {"const": "backend_observed"}, "evidence_ref": {"$ref": "#/definitions/AgentEvidenceRef"}}}
      ]
    },
    "GapClientConfigurationRunCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "GAP"}, "observation_basis": {"const": "client_reported"}, "evidence_ref": {"$ref": "#/definitions/ConfigurationRunEvidenceRef"}}}
      ]
    },
    "UnknownCheck": {
      "allOf": [
        {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvidenceCheck"},
        {"properties": {"state": {"const": "UNKNOWN"}}}
      ]
    },
    "SupportedCheckState": {
      "properties": {"state": {"const": "SUPPORTED"}}
    },
    "GapOrUnknownCheckState": {
      "oneOf": [
        {"properties": {"state": {"const": "GAP"}}},
        {"properties": {"state": {"const": "UNKNOWN"}}}
      ]
    },
    "UnknownCheckState": {
      "properties": {"state": {"const": "UNKNOWN"}}
    },
    "AgentRecordAvailableCheck": {
      "allOf": [{"$ref": "#/definitions/SupportedBackendAgentCheck"}, {"properties": {"check_id": {"const": "AGENT_RECORD_AVAILABLE"}}}]
    },
    "CompletedEvaluationRunCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedBackendExperimentRunCheck"}, {"properties": {"check_id": {"const": "COMPLETED_EVALUATION_RUN"}}}]},
        {"allOf": [{"$ref": "#/definitions/GapBackendAgentCheck"}, {"properties": {"check_id": {"const": "COMPLETED_EVALUATION_RUN"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "COMPLETED_EVALUATION_RUN"}}}]}
      ]
    },
    "AccuracyMeasureRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedClientConfigurationRunCheck"}, {"properties": {"check_id": {"const": "ACCURACY_MEASURE_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "ACCURACY_MEASURE_RECORDED"}}}]}
      ]
    },
    "UnitBearingEfficiencyMeasureRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedClientConfigurationRunCheck"}, {"properties": {"check_id": {"const": "UNIT_BEARING_EFFICIENCY_MEASURE_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "UNIT_BEARING_EFFICIENCY_MEASURE_RECORDED"}}}]}
      ]
    },
    "EvaluatorVersionSnapshotRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedServerEvaluatorVersionCheck"}, {"properties": {"check_id": {"const": "EVALUATOR_VERSION_SNAPSHOT_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "EVALUATOR_VERSION_SNAPSHOT_RECORDED"}}}]}
      ]
    },
    "EvaluatorExecutionLinkAssessedCheck": {
      "allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "EVALUATOR_EXECUTION_LINK_ASSESSED"}}}]
    },
    "EvaluatorStabilityAssessedCheck": {
      "allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "EVALUATOR_STABILITY_ASSESSED"}}}]
    },
    "RunDatasetIdentityRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedServerEvaluationDatasetCheck"}, {"properties": {"check_id": {"const": "RUN_DATASET_IDENTITY_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "RUN_DATASET_IDENTITY_RECORDED"}}}]}
      ]
    },
    "EvaluatedExampleCountRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedClientConfigurationRunCheck"}, {"properties": {"check_id": {"const": "EVALUATED_EXAMPLE_COUNT_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/GapClientConfigurationRunCheck"}, {"properties": {"check_id": {"const": "EVALUATED_EXAMPLE_COUNT_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "EVALUATED_EXAMPLE_COUNT_RECORDED"}}}]}
      ]
    },
    "DatasetQualityAssessmentRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedBackendDatasetQualityCheck"}, {"properties": {"check_id": {"const": "DATASET_QUALITY_ASSESSMENT_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "DATASET_QUALITY_ASSESSMENT_RECORDED"}}}]}
      ]
    },
    "ExperimentPathRecordedCheck": {
      "oneOf": [
        {"allOf": [{"$ref": "#/definitions/SupportedBackendExperimentCheck"}, {"properties": {"check_id": {"const": "EXPERIMENT_PATH_RECORDED"}}}]},
        {"allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "EXPERIMENT_PATH_RECORDED"}}}]}
      ]
    },
    "SelectedConfigurationRecordedCheck": {
      "allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "SELECTED_CONFIGURATION_RECORDED"}}}]
    },
    "SelectionLedgerMatchAssessedCheck": {
      "allOf": [{"$ref": "#/definitions/UnknownCheck"}, {"properties": {"check_id": {"const": "SELECTION_LEDGER_MATCH_ASSESSED"}}}]
    },
    "CurrentDatasetAssociation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        "evaluation_dataset_ref": {"$ref": "#/definitions/EvaluationDatasetRef"},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["experiment_id", "evaluation_dataset_ref", "observed_at"]
    },
    "CurrentContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation_dataset_association": {
          "oneOf": [
            {"$ref": "#/definitions/CurrentDatasetAssociation"},
            {"type": "null"}
          ]
        }
      },
      "required": ["evaluation_dataset_association"]
    },
    "JourneyItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        "experiment_name": {"type": ["string", "null"], "maxLength": 512},
        "run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
        "is_anchor": {"type": "boolean"},
        "status": {"$ref": "https://schemas.traigent.ai/status_schema.json#/definitions/ExperimentRunStatus"},
        "started_at": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/NullableDateTime"},
        "completed_at": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/NullableDateTime"},
        "evaluation_dataset_ref": {
          "oneOf": [
            {"$ref": "#/definitions/EvaluationDatasetRef"},
            {"type": "null"}
          ]
        },
        "evaluator_version_ref": {
          "oneOf": [
            {"$ref": "#/definitions/EvaluatorVersionRef"},
            {"type": "null"}
          ]
        },
        "identity_snapshot_state": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/IdentitySnapshotState"},
        "metric_configuration_run_id": {
          "oneOf": [
            {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
            {"type": "null"}
          ]
        },
        "reported_example_evaluations": {"type": ["integer", "null"], "minimum": 0},
        "reported_metrics": {
          "$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/ReportedMetrics"
        },
        "record_observation_basis": {"const": "backend_observed"},
        "dataset_reference_change": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/ReferenceChange"},
        "evaluator_reference_change": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/ReferenceChange"}
      },
      "required": [
        "experiment_id",
        "experiment_name",
        "run_id",
        "is_anchor",
        "status",
        "started_at",
        "completed_at",
        "evaluation_dataset_ref",
        "evaluator_version_ref",
        "identity_snapshot_state",
        "metric_configuration_run_id",
        "reported_example_evaluations",
        "reported_metrics",
        "record_observation_basis",
        "dataset_reference_change",
        "evaluator_reference_change"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"properties": {"reported_metrics": {"minItems": 1}}},
              {"properties": {"reported_example_evaluations": {"type": "integer"}}}
            ]
          },
          "then": {
            "properties": {
              "metric_configuration_run_id": {
                "$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "identity_snapshot_state": {"const": "NOT_RECORDED"}
            }
          },
          "then": {
            "properties": {
              "evaluation_dataset_ref": {"type": "null"},
              "evaluator_version_ref": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
