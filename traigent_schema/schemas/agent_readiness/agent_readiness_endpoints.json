{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Backend Agent Readiness Routes",
    "version": "1.0.0",
    "description": "Canonical read-only project-scoped Agent readiness projection routes."
  },
  "paths": {
    "/api/v1beta/projects/{project_id}/agent-readiness": {
      "get": {
        "summary": "List project Agent readiness evidence",
        "operationId": "listProjectAgentReadiness",
        "x-asserted-against-backend": false,
        "parameters": [
          {"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "default": 1}},
          {"name": "per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}},
          {"name": "search", "in": "query", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 200}},
          {"name": "stage", "in": "query", "required": false, "schema": {"$ref": "./agent_readiness_common_schema.json#/definitions/ProcessStage"}},
          {"name": "attention", "in": "query", "required": false, "schema": {"$ref": "./agent_readiness_common_schema.json#/definitions/AttentionState"}},
          {"name": "deployment_stage", "in": "query", "required": false, "description": "E4: keep only Agents whose current manager-set posture has this deployment stage; Agents with no declared posture are excluded when set.", "schema": {"$ref": "./agent_posture_schema.json#/definitions/DeploymentStage"}},
          {"name": "criticality", "in": "query", "required": false, "description": "E4: keep only Agents whose current manager-set posture has this criticality; Agents with no declared posture are excluded when set.", "schema": {"$ref": "./agent_posture_schema.json#/definitions/Criticality"}}
        ],
        "responses": {
          "200": {
            "description": "Project Agent readiness evidence retrieved successfully",
            "content": {"application/json": {"schema": {"$ref": "./agent_readiness_portfolio_response_schema.json"}}}
          },
          "400": {"description": "Invalid pagination, search, stage, attention, deployment_stage, or criticality parameters", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "401": {"description": "Unauthenticated", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "403": {"description": "Project Agent-read access denied", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}}
        }
      }
    },
    "/api/v1beta/projects/{project_id}/agent-readiness/{agent_id}": {
      "get": {
        "summary": "Get project Agent readiness evidence detail",
        "operationId": "getProjectAgentReadinessDetail",
        "x-asserted-against-backend": false,
        "parameters": [
          {"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"name": "agent_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"name": "journey_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "default": 1}},
          {"name": "journey_per_page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 50, "default": 25}}
        ],
        "responses": {
          "200": {
            "description": "Project Agent readiness detail retrieved successfully",
            "content": {"application/json": {"schema": {"$ref": "./agent_readiness_detail_response_schema.json"}}}
          },
          "400": {"description": "Invalid journey pagination parameters", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "401": {"description": "Unauthenticated", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "403": {"description": "Project Agent-read access denied", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "404": {"description": "Agent not found in the authorized project scope", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}}
        }
      }
    },
    "/api/v1beta/projects/{project_id}/agent-readiness/{agent_id}/target-revisions": {
      "post": {
        "summary": "Declare or replace the project Agent team latency or accuracy requirement",
        "description": "Each metric (SDK_MEAN_RESPONSE_TIME, SDK_MEAN_ACCURACY) keeps its own immutable revision chain per Agent; expected_current_revision_id is checked against the declared metric's chain only.",
        "operationId": "createAgentReadinessTargetRevision",
        "x-asserted-against-backend": false,
        "parameters": [
          {"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
          {"name": "agent_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "./agent_readiness_target_schema.json#/definitions/TargetDeclarationRequest"}}}
        },
        "responses": {
          "201": {"description": "Immutable target revision created", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_target_schema.json#/definitions/DeclaredTarget"}}}},
          "400": {"description": "Invalid target declaration", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "401": {"description": "Unauthenticated", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "403": {"description": "Project Agent write access denied", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "404": {"description": "Agent or source run not found in the authorized project scope", "content": {"application/json": {"schema": {"$ref": "./agent_readiness_error_schema.json"}}}},
          "409": {
            "description": "The immutable target changed since the form was loaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["success", "message", "error", "error_code"],
                  "properties": {
                    "success": {"const": false},
                    "message": {"const": "This requirement changed. Reload the current revision before saving."},
                    "error": {"const": "revision_conflict"},
                    "error_code": {"const": "revision_conflict"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
