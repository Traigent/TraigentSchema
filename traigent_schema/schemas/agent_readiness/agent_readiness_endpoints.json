{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Backend Agent Readiness Routes",
    "version": "1.0.0",
    "description": "Project-scoped Agent readiness routes at /api/v1/projects/{project_id}/agent-readiness (search) and /api/v1/projects/{project_id}/agents/{agent_ref} (readiness, lifecycle history, target revisions, next step)."
  },
  "paths": {
    "/api/v1/projects/{project_id}/agent-readiness/search": {
      "post": {
        "summary": "List project Agent readiness evidence (search)",
        "operationId": "project_agent_readiness.list_agent_readiness",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project Agent readiness evidence retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_portfolio_response_schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination, search, stage, attention, deployment_stage, or criticality parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Project Agent-read access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Closed not-found (path project or agent outside the caller's reach)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 20,
                    "description": "Page size; above 100 is rejected with a 400, never clamped. Replaces page/per_page, which are rejected."
                  },
                  "cursor": {
                    "type": "string",
                    "maxLength": 4096,
                    "description": "Opaque next_cursor of the previous page, bound to the caller, project and filters."
                  },
                  "search": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "stage": {
                    "$ref": "./agent_readiness_common_schema.json#/definitions/ProcessStage"
                  },
                  "attention": {
                    "$ref": "./agent_readiness_common_schema.json#/definitions/AttentionState"
                  },
                  "deployment_stage": {
                    "$ref": "./agent_posture_schema.json#/definitions/DeploymentStage",
                    "description": "E4: keep only Agents whose current manager-set posture has this deployment stage; Agents with no declared posture are excluded when set."
                  },
                  "criticality": {
                    "$ref": "./agent_posture_schema.json#/definitions/Criticality",
                    "description": "E4: keep only Agents whose current manager-set posture has this criticality; Agents with no declared posture are excluded when set."
                  }
                }
              }
            }
          }
        },
        "x-replay": "read"
      }
    },
    "/api/v1/projects/{project_id}/agents/{agent_ref}/lifecycle-history": {
      "get": {
        "summary": "Get project Agent recorded lifecycle history bridged via experiment-run links",
        "description": "Lane 3: closed, paginated view of agent-lifecycle-record revisions bridged onto this Agent through an experiment-run link (record.experiment_run_id or one of the revision's run plans' experiment_run_id resolving to an ExperimentRun whose Experiment.agent_id matches). A derived association, never a causal claim; no attribution, actor identity, or record content is returned. An agent invisible in the authorized project scope (unknown or foreign, archived excluded) returns the same generic readiness 404 as GET .../agent-readiness/{agent_id}.",
        "operationId": "project_agent_readiness.get_agent_lifecycle_history",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size; above 100 is rejected with a 400, never clamped. page, per_page and offset are rejected.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque next_cursor of the previous page, bound to the caller, project and agent.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project Agent lifecycle history retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_lifecycle_history_response_schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid limit or cursor, or a retired page/per_page/offset parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Project Agent-read access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Agent not found in the authorized project scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/agents/{agent_ref}/next-step": {
      "get": {
        "summary": "The one next step for this agent",
        "operationId": "project_agent_readiness.get_agent_next_step",
        "x-asserted-against-backend": false,
        "description": "AgentNextStep contract v1: the ONE next step for the agent, computed by the readiness resolver. An agent the caller cannot see is the closed 404; a failed read is the closed 503 (no exception text).",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The next step",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_next_step_response_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Agent not found in the project or not visible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Closed unavailable body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/agents/{agent_ref}/readiness": {
      "get": {
        "summary": "Get project Agent readiness evidence detail",
        "operationId": "project_agent_readiness.get_agent_readiness",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "journey_limit",
            "in": "query",
            "required": false,
            "description": "Journey page size; above 100 is rejected with a 400, never clamped. journey_page and journey_per_page are rejected.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "journey_cursor",
            "in": "query",
            "required": false,
            "description": "Opaque journey.pagination.next_cursor of the previous page, bound to the caller, project and agent.",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project Agent readiness detail retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_detail_response_schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid journey pagination parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Project Agent-read access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Agent not found in the authorized project scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/agents/{agent_ref}/target-revisions": {
      "post": {
        "summary": "Declare or replace the project Agent team latency or accuracy requirement",
        "description": "Each metric (SDK_MEAN_RESPONSE_TIME, SDK_MEAN_ACCURACY) keeps its own immutable revision chain per Agent; expected_current_revision_id is checked against the declared metric's chain only.",
        "operationId": "project_agent_readiness.create_agent_readiness_target",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent_ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./agent_readiness_target_schema.json#/definitions/TargetDeclarationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable target revision created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_target_schema.json#/definitions/DeclaredTarget"
                }
              }
            }
          },
          "400": {
            "description": "Invalid target declaration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Project Agent write access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Agent or source run not found in the authorized project scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "409": {
            "description": "The immutable target changed since the form was loaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "message",
                    "error",
                    "error_code"
                  ],
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "message": {
                      "const": "This requirement changed. Reload the current revision before saving."
                    },
                    "error": {
                      "const": "revision_conflict"
                    },
                    "error_code": {
                      "const": "revision_conflict"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests: rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
