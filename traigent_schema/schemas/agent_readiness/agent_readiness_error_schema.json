{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/agent_readiness/agent_readiness_error_schema.json",
  "title": "Agent Readiness Error Envelope",
  "description": "Closed, content-free 4xx error envelope for Agent readiness routes. Public strings are finite server-controlled values; details, request data, identifiers, exception text, and internal diagnostics are not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "message", "error", "error_code"],
  "properties": {
    "success": {"const": false},
    "message": {
      "type": "string",
      "enum": [
        "Invalid request",
        "Authentication required",
        "Authorization denied",
        "Not found"
      ]
    },
    "error": {
      "type": "string",
      "enum": [
        "invalid_request",
        "authentication_required",
        "authorization_denied",
        "not_found"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "authentication_required",
        "authorization_denied",
        "not_found"
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/InvalidRequest"},
    {"$ref": "#/definitions/AuthenticationRequired"},
    {"$ref": "#/definitions/AuthorizationDenied"},
    {"$ref": "#/definitions/NotFound"}
  ],
  "definitions": {
    "InvalidRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "message", "error", "error_code"],
      "properties": {
        "success": {"const": false},
        "message": {"const": "Invalid request"},
        "error": {"const": "invalid_request"},
        "error_code": {"const": "invalid_request"}
      }
    },
    "AuthenticationRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "message", "error", "error_code"],
      "properties": {
        "success": {"const": false},
        "message": {"const": "Authentication required"},
        "error": {"const": "authentication_required"},
        "error_code": {"const": "authentication_required"}
      }
    },
    "AuthorizationDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "message", "error", "error_code"],
      "properties": {
        "success": {"const": false},
        "message": {"const": "Authorization denied"},
        "error": {"const": "authorization_denied"},
        "error_code": {"const": "authorization_denied"}
      }
    },
    "NotFound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "message", "error", "error_code"],
      "properties": {
        "success": {"const": false},
        "message": {"const": "Not found"},
        "error": {"const": "not_found"},
        "error_code": {"const": "not_found"}
      }
    }
  }
}
