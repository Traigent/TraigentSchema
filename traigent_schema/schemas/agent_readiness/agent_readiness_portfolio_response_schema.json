{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/agent_readiness/agent_readiness_portfolio_response_schema.json",
  "title": "Agent Readiness Portfolio Response",
  "description": "Content-free project-scoped Agent portfolio. It reports record coverage for three artifacts and a separate process stage; it contains no readiness, certification, or composite score.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "as_of": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/AgentSummary"},
          "anchor_run_id": {
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
              {"type": "null"}
            ]
          },
          "anchor_experiment_id": {
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
              {"type": "null"}
            ]
          },
          "next_action_experiment_id": {
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
              {"type": "null"}
            ]
          },
          "next_action_run_id": {
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
              {"type": "null"}
            ]
          },
          "anchor_completed_at": {
            "oneOf": [
              {"type": "string", "format": "date-time"},
              {"type": "null"}
            ]
          },
          "pillars": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agent": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/PillarSummary"},
              "evaluator": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/PillarSummary"},
              "evaluation_dataset": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/PillarSummary"}
            },
            "required": ["agent", "evaluator", "evaluation_dataset"]
          },
          "process": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/ProcessStage"},
              "coverage_state": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageState"},
              "supported_checks": {"type": "integer", "minimum": 0},
              "gap_checks": {"type": "integer", "minimum": 0},
              "unknown_checks": {"type": "integer", "minimum": 0},
              "top_gap_code": {
                "oneOf": [
                  {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CheckId"},
                  {"type": "null"}
                ]
              }
            },
            "required": ["stage", "coverage_state", "supported_checks", "gap_checks", "unknown_checks", "top_gap_code"],
            "allOf": [{"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/CoverageFromCounts"}]
          },
          "last_activity_at": {
            "oneOf": [
              {"type": "string", "format": "date-time"},
              {"type": "null"}
            ]
          },
          "next_action_code": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/NextActionCode"},
          "attention_state": {
            "description": "Deterministic classification of the existing typed next action; GAP alone is not actionable.",
            "$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/AttentionState"
          },
          "evaluation_system_validity": {
            "$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/EvaluationSystemValidity"
          },
          "agent_posture": {
            "description": "E4: the Agent's current manager-set posture (deployment stage and criticality), or NONE_DECLARED.",
            "$ref": "https://schemas.traigent.ai/agent_readiness/agent_posture_schema.json#/definitions/AgentPosture"
          },
          "anchor_evaluation_dataset_ref": {
            "description": "E1 (fleet posture): the anchor run's evaluation-dataset reference, the same value the detail response reports as anchor_summary.evaluation_dataset_ref, so the fleet view can group agents by shared evaluation dataset without a per-agent detail fetch. Null when there is no anchor run or the anchor run recorded no dataset identity. Optional: the five anchor_* E1 members are emitted together or not at all.",
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_detail_response_schema.json#/definitions/EvaluationDatasetRef"},
              {"type": "null"}
            ]
          },
          "anchor_evaluator_version_ref": {
            "description": "E1: the anchor run's evaluator-version reference (detail anchor_summary.evaluator_version_ref). Null when there is no anchor run or no evaluator-version snapshot was recorded.",
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_detail_response_schema.json#/definitions/EvaluatorVersionRef"},
              {"type": "null"}
            ]
          },
          "anchor_accuracy": {
            "description": "E1: the anchor run's client-reported accuracy measure, the ACCURACY entry of detail anchor_summary.reported_metrics. Always client_reported with UNIT_NOT_RECORDED; it is a recorded fact, never a verified score. Null when there is no anchor run or no eligible accuracy measure was recorded.",
            "oneOf": [
              {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/AccuracyMetric"},
              {"type": "null"}
            ]
          },
          "anchor_accuracy_sample_count": {
            "description": "E1: the positive count the anchor accuracy mean was computed over (the accuracy.count the Backend already reads for the ACCURACY_MEASURE_RECORDED check). Non-null only when anchor_accuracy is non-null with source_key accuracy.mean; a scalar accuracy carries no count.",
            "oneOf": [
              {"type": "integer", "minimum": 1},
              {"type": "null"}
            ]
          },
          "anchor_reported_example_evaluations": {
            "description": "E1: the anchor run's client-reported evaluated-example total (detail anchor_summary.reported_example_evaluations). Null when there is no anchor run or no total was reported.",
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "required": [
          "agent",
          "anchor_run_id",
          "anchor_experiment_id",
          "anchor_completed_at",
          "next_action_experiment_id",
          "next_action_run_id",
          "pillars",
          "process",
          "last_activity_at",
          "next_action_code",
          "attention_state",
          "evaluation_system_validity",
          "agent_posture"
        ],
        "dependencies": {
          "anchor_evaluation_dataset_ref": ["anchor_evaluator_version_ref", "anchor_accuracy", "anchor_accuracy_sample_count", "anchor_reported_example_evaluations"],
          "anchor_evaluator_version_ref": ["anchor_evaluation_dataset_ref", "anchor_accuracy", "anchor_accuracy_sample_count", "anchor_reported_example_evaluations"],
          "anchor_accuracy": ["anchor_evaluation_dataset_ref", "anchor_evaluator_version_ref", "anchor_accuracy_sample_count", "anchor_reported_example_evaluations"],
          "anchor_accuracy_sample_count": ["anchor_evaluation_dataset_ref", "anchor_evaluator_version_ref", "anchor_accuracy", "anchor_reported_example_evaluations"],
          "anchor_reported_example_evaluations": ["anchor_evaluation_dataset_ref", "anchor_evaluator_version_ref", "anchor_accuracy", "anchor_accuracy_sample_count"]
        },
        "allOf": [
          {
            "if": {"properties": {"anchor_run_id": {"type": "null"}}},
            "then": {
              "properties": {
                "anchor_evaluation_dataset_ref": {"type": "null"},
                "anchor_evaluator_version_ref": {"type": "null"},
                "anchor_accuracy": {"type": "null"},
                "anchor_accuracy_sample_count": {"type": "null"},
                "anchor_reported_example_evaluations": {"type": "null"}
              }
            }
          },
          {
            "if": {
              "properties": {"anchor_accuracy_sample_count": {"type": "integer"}},
              "required": ["anchor_accuracy_sample_count"]
            },
            "then": {
              "properties": {
                "anchor_accuracy": {
                  "not": {"type": "null"},
                  "properties": {"source_key": {"const": "accuracy.mean"}},
                  "required": ["source_key"]
                }
              }
            }
          },
          {
            "oneOf": [
              {
                "properties": {
                  "process": {
                    "properties": {
                      "stage": {"enum": ["NO_RUNS", "RUNS_RECORDED"]}
                    }
                  },
                  "anchor_run_id": {"type": "null"},
                  "anchor_experiment_id": {"type": "null"},
                  "anchor_completed_at": {"type": "null"}
                }
              },
              {
                "properties": {
                  "process": {
                    "properties": {
                      "stage": {"const": "EVALUATION_COMPLETED"}
                    }
                  },
                  "anchor_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
                  "anchor_experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"},
                  "anchor_completed_at": {
                    "oneOf": [
                      {"type": "string", "format": "date-time"},
                      {"type": "null"}
                    ]
                  }
                }
              }
            ]
          },
          {
            "oneOf": [
              {"properties": {"next_action_code": {"const": "ESTABLISH_BASELINE_EVALUATION"}, "next_action_experiment_id": {"type": "null"}, "next_action_run_id": {"type": "null"}}},
              {"properties": {"next_action_code": {"const": "COMPLETE_EVALUATION_RUN"}, "next_action_experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}, "next_action_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}}},
              {"properties": {"next_action_code": {"enum": ["EVALUATE_DATASET_EXAMPLES", "RECORD_ACCURACY_MEASURE", "REVIEW_RECORDED_EVIDENCE"]}, "next_action_experiment_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}, "next_action_run_id": {"$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"}}}
            ]
          }
        ]
      }
    },
    "portfolio_counts": {
      "description": "Counts over the complete authorized project portfolio before search, filters, or pagination.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_agents": {"type": "integer", "minimum": 0},
        "by_stage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "NO_RUNS": {"type": "integer", "minimum": 0},
            "RUNS_RECORDED": {"type": "integer", "minimum": 0},
            "EVALUATION_COMPLETED": {"type": "integer", "minimum": 0}
          },
          "required": ["NO_RUNS", "RUNS_RECORDED", "EVALUATION_COMPLETED"]
        },
        "by_attention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ACTIONABLE": {"type": "integer", "minimum": 0},
            "NO_PORTAL_ACTION": {"type": "integer", "minimum": 0}
          },
          "required": ["ACTIONABLE", "NO_PORTAL_ACTION"]
        }
      },
      "required": ["total_agents", "by_stage", "by_attention"]
    },
    "ordering": {"const": "STAGE_THEN_LEAST_RECENT_ACTIVITY"},
    "pagination": {
      "allOf": [
        {"$ref": "../pagination_schema.json"},
        {"properties": {"per_page": {"maximum": 100}}}
      ]
    }
  },
  "required": ["schema_version", "as_of", "items", "portfolio_counts", "ordering", "pagination"]
}
