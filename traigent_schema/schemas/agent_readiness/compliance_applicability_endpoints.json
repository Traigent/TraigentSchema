{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Backend Compliance Applicability Routes",
    "version": "1.0.0",
    "description": "Project-scoped applicability screen (AGB-74 slice 4). Ships dark behind the same operator flag as the evidence view: while off, every route answers the standard not-found envelope as if it did not exist. The screening answers and the rationale are customer content and travel in bodies only."
  },
  "paths": {
    "/api/v1beta/projects/{project_id}/compliance-applicability": {
      "post": {
        "summary": "Record an applicability revision (project admin, human session)",
        "operationId": "createComplianceApplicabilityRevision",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./compliance_applicability_schema.json#/definitions/ApplicabilityRevisionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Revision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./compliance_applicability_schema.json#/definitions/ApplicabilityRevisionRecord"
                }
              }
            }
          },
          "400": {
            "description": "Closed-request violation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the feature is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "message",
                    "error",
                    "error_code"
                  ],
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "The applicability screen changed since it was displayed."
                      ]
                    },
                    "error": {
                      "type": "string",
                      "enum": [
                        "stale_revision"
                      ]
                    },
                    "error_code": {
                      "type": "string",
                      "enum": [
                        "stale_revision"
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1beta/projects/{project_id}/compliance-applicability/suggestions": {
      "post": {
        "summary": "Evaluate suggestions for posted screening answers (project members; pure, nothing is stored)",
        "operationId": "suggestComplianceApplicability",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./compliance_applicability_schema.json#/definitions/SuggestionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Suggestions per visible obligation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./compliance_applicability_schema.json#/definitions/SuggestionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Closed-request violation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the feature is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1beta/projects/{project_id}/compliance-applicability/agents/{agent_id}": {
      "get": {
        "summary": "The current applicability screen of one Agent, with paginated history (project members)",
        "operationId": "getComplianceApplicability",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current snapshot with read-time evaluation, and history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./compliance_applicability_schema.json#/definitions/ApplicabilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the feature is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
