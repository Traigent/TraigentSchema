          },
          "403": {
            "description": "Denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or the feature is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "success",
                    "message",
                    "error",
                    "error_code"
                  ],
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "This statement is already granted to that member."
                      ]
