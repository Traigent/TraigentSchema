                    "success",
                    "message",
                    "error",
                    "error_code"
                  ],
                  "properties": {
                    "success": {
                      "const": false
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "The statement changed since it was displayed.",
                        "The agent changed since it was displayed.",
                        "A statement of this kind needs at least one linked document reference.",
                        "A linked document reference is not valid for this agent."
                      ]
                    },
                    "error": {
                      "type": "string",
