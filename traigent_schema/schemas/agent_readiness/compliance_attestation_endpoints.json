{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Backend Compliance Attestation Routes",
    "version": "1.0.0",
    "description": "Project-scoped attester grants and authenticated attestations (AGB-74 slice 2). Ships dark behind the same operator flag as the evidence view: while off, every route answers the standard not-found envelope as if it did not exist."
  },
