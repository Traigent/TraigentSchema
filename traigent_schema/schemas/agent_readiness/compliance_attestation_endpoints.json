              "application/json": {
                "schema": {
                  "$ref": "./compliance_attestation_schema.json#/definitions/AttesterGrantRecord"
                }
              }
            }
          },
          "400": {
            "description": "Closed-request violation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
