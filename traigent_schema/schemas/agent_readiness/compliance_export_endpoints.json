{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Backend Compliance Evidence Export Routes",
    "version": "1.0.0",
    "description": "Project-scoped evidence export pack (AGB-74 slice 5). Ships dark behind the same operator flag as the evidence view: while off, the route answers the standard not-found envelope as if it did not exist. Human project members only; an API key is refused. The ZIP carries customer content and is never cached."
  },
  "paths": {
    "/api/v1beta/projects/{project_id}/compliance-evidence-exports/agents/{agent_id}": {
      "post": {
        "summary": "Export the evidence pack of an Agent as a ZIP (human project member)",
        "description": "Synchronous. The body is an empty object. Files: manifest.json (see compliance_export_manifest_schema.json#/definitions/Manifest), coverage.json, coverage.html, applicability.json, attestations.json, documents.json, measurements.json. Refused closed with 413 above 20 MiB of file content. Every export writes an audit record holding the export id, the actor and the manifest SHA-256.",
        "operationId": "exportProjectAgentComplianceEvidence",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./compliance_export_manifest_schema.json#/definitions/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The evidence pack",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string",
                  "pattern": "^attachment; filename=\"compliance-evidence-cee_[0-9a-f]{32}\\.zip\"$"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Closed-request violation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Denied (not a human project member)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Agent not found in the authorized project scope, or the feature is off",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./agent_readiness_error_schema.json"
                }
              }
            }
          },
          "413": {
            "description": "The pack would exceed the size cap; nothing is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./compliance_export_error_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
