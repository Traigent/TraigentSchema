{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/agent_readiness/compliance_export_manifest_schema.json",
  "title": "Compliance Evidence Export Manifest",
  "description": "AGB-74 slice 5: the closed manifest.json of the evidence export pack, and its empty request. The pack is a ZIP built synchronously for a human project member; it is evidence coverage, not a compliance determination. The manifest is an INTEGRITY MANIFEST: the SHA-256 of every other file in the pack. It is not a digital signature. It lists generation time (server), the catalogue version and digest, the pack versions, per-section completeness, fixed limitations text and the reasons the PDF and the offline replay bundle are absent. The pack holds CUSTOMER CONTENT (document URLs, applicability facts and rationale, attestation notes) and is returned only to the authorised member who requested it; it is never logged. An attestation note is included only where the reader may read it in the product, and the count of withheld notes is declared. Fixed files: coverage.json (the evidence response), coverage.html, applicability.json, attestations.json, documents.json, measurements.json (measured rows keep observation_basis client_reported). Fixed filename compliance-evidence-<export_id>.zip, Cache-Control no-store.",
  "definitions": {
    "ExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0,
      "description": "An empty object. There are no options: the pack contents are fixed."
    },
    "ExportId": {
      "type": "string",
      "pattern": "^cee_[0-9a-f]{32}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "FileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "applicability.json",
            "attestations.json",
            "coverage.html",
            "coverage.json",
            "documents.json",
            "measurements.json"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "applicability",
        "attestations",
        "documents",
        "measurements",
        "erased_identities",
        "tvl_offline_bundle",
        "pdf"
      ],
      "properties": {
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "attestations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            },
            "notes_withheld": {
              "type": "integer",
              "minimum": 0,
              "description": "Attestation notes left out because this reader may not read them in the product."
            }
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "erased_identities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "tvl_offline_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "pdf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "records"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "records": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "export_id",
        "generated_at",
        "catalogue",
        "pack_versions",
        "files",
        "completeness",
        "limitations",
        "integrity",
        "pdf",
        "pdf_reason",
        "tvl_offline_bundle",
        "tvl_offline_bundle_reason",
        "contains_customer_content",
        "customer_content_note"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "export_id": {
          "$ref": "#/definitions/ExportId"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server time."
        },
        "catalogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "manifest_sha256",
            "draft"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "manifest_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "draft": {
              "type": "boolean"
            }
          }
        },
        "pack_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "framework_id",
              "semver",
              "draft"
            ],
            "properties": {
              "framework_id": {
                "type": "string"
              },
              "semver": {
                "type": "string"
              },
              "draft": {
                "type": "boolean"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/FileDigest"
          },
          "description": "Every file except manifest.json itself, sorted by name."
        },
        "completeness": {
          "$ref": "#/definitions/Completeness"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Fixed copy."
        },
        "integrity": {
          "const": "sha256 manifest"
        },
        "pdf": {
          "const": "not_included"
        },
        "pdf_reason": {
          "type": "string"
        },
        "tvl_offline_bundle": {
          "const": "not_available"
        },
        "tvl_offline_bundle_reason": {
          "type": "string"
        },
        "contains_customer_content": {
          "const": true
        },
        "customer_content_note": {
          "type": "string"
        }
      }
    }
  }
}
