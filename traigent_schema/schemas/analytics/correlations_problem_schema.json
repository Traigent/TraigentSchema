          "x-content-class": "closed_enum"
        },
        "detail": {
          "const": "Authentication is required.",
          "x-content-class": "closed_enum"
        },
        "problem_id": {
          "const": "b7351f9e417dcb0f3b2afdfd70ffb1e4",
          "x-content-class": "opaque_ref"
        }
      }
    },
