      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "problem_id"
      ],
      "x-privacy-classification": "aggregate_safe",
      "properties": {
        "type": {
          "const": "urn:traigent:problem:unauthenticated",
          "x-content-class": "closed_enum"
        },
        "title": {
          "const": "Unauthorized",
          "x-content-class": "closed_enum"
        },
        "status": {
