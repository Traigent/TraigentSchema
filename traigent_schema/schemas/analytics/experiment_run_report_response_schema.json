      "type": "boolean",
      "const": true
    },
    "message": {
      "type": "string",
      "maxLength": 240
    },
    "data": {
      "$ref": "#/definitions/BoundedReport"
    },
    "meta": {
      "$ref": "#/definitions/MetaMap"
    },
    "metadata": {
      "$ref": "#/definitions/BoundedScalarMap"
    }
  },
  "required": [
    "success",
    "message",
    "data",
    "meta"
  ],
