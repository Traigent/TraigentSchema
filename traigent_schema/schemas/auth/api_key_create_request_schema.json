{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/auth/api_key_create_request_schema.json",
  "title": "API Key Create Request",
  "description": "Request body for POST /api/v1/keys.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Human-readable label for the key."
    },
    "key_type": {
      "type": "string",
      "enum": ["user", "service", "admin", "temporary", "readonly", "system", "director"],
      "default": "user",
      "description": "API key type."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional client-visible description."
    },
    "project_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional project identifier."
    },
    "scopes": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64},
      "description": "Requested scope values."
    },
    "permissions": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64},
      "default": ["read"],
      "description": "Requested permission values."
    },
    "scope_preset": {
      "type": "string",
      "enum": ["minimal", "sdk-compat"],
      "default": "minimal",
      "description": "Default scope and permission preset when the corresponding value is omitted."
    },
    "expires_in_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650,
      "description": "Optional lifetime in days."
    },
    "allowed_ips": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64},
      "description": "Optional allowed IP address entries."
    },
    "rotation_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether rotation scheduling is configured for this key."
    },
    "rotation_interval_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 90,
      "description": "Rotation interval in days."
    },
    "auto_rotate": {
      "type": "boolean",
      "default": false,
      "description": "Whether automatic rotation is enabled for this key."
    },
    "replace_if_exists": {
      "type": "boolean",
      "default": false,
      "description": "Whether to replace an existing key with the same label."
    },
    "metadata": {
      "type": "object",
      "description": "Optional client-defined metadata."
    },
    "resource_grants": {
      "type": "array",
      "description": "Initial per-resource grants created atomically with the key. Required for key_type=director.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_type", "resource_id", "permissions", "expires_at"],
        "properties": {
          "resource_type": {
            "type": "string",
            "enum": ["experiment"]
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "permissions": {
            "type": "array",
            "items": {"type": "string", "enum": ["read"]},
            "minItems": 1,
            "maxItems": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": ["key_name"],
  "allOf": [
    {
      "if": {
        "properties": {"key_type": {"const": "director"}},
        "required": ["key_type"]
      },
      "then": {
        "required": ["scopes", "permissions", "resource_grants"],
        "properties": {
          "scopes": {"const": ["director_evidence:read"]},
          "permissions": {"maxItems": 0},
          "resource_grants": {"minItems": 1},
          "scope_preset": {"not": {}}
        }
      },
      "else": {
        "properties": {
          "scopes": {"minItems": 1},
          "permissions": {"minItems": 1},
          "resource_grants": {"not": {}}
        }
      }
    }
  ],
  "x-backend-obligations": [
    "For key_type=director, each grant's expires_at is no later than 30 days after the request is processed, and the key is rejected with 400 (nothing persisted) otherwise.",
    "Each granted experiment must belong to the caller's authenticated project/tenant context.",
    "A director key's type is immutable, and its scopes/permissions/grants invariants hold on the merged persisted state."
  ]
}
