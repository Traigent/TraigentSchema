{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/auth/api_key_create_request_schema.json",
  "title": "API Key Create Request",
  "description": "Request body for POST /api/v1/keys.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Human-readable label for the key."
    },
    "key_type": {
      "type": "string",
      "enum": ["user", "service", "admin", "temporary", "readonly", "system"],
      "default": "user",
      "description": "API key type."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional client-visible description."
    },
    "project_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "description": "Optional project identifier."
    },
    "scopes": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64},
      "minItems": 1,
      "description": "Requested scope values."
    },
    "permissions": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64},
      "minItems": 1,
      "default": ["read"],
      "description": "Requested permission values."
    },
    "scope_preset": {
      "type": "string",
      "enum": ["minimal", "sdk-compat"],
      "default": "minimal",
      "description": "Default scope and permission preset when the corresponding value is omitted."
    },
    "expires_in_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650,
      "description": "Optional lifetime in days."
    },
    "allowed_ips": {
      "type": "array",
      "items": {"type": "string", "maxLength": 64},
      "description": "Optional allowed IP address entries."
    },
    "rotation_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether rotation scheduling is configured for this key."
    },
    "rotation_interval_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 90,
      "description": "Rotation interval in days."
    },
    "auto_rotate": {
      "type": "boolean",
      "default": false,
      "description": "Whether automatic rotation is enabled for this key."
    },
    "replace_if_exists": {
      "type": "boolean",
      "default": false,
      "description": "Whether to replace an existing key with the same label."
    },
    "metadata": {
      "type": "object",
      "description": "Optional client-defined metadata."
    }
  },
  "required": ["key_name"]
}
