{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/auth/api_key_detail_schema.json",
  "title": "API Key Detail",
  "description": "API key detail returned by API key management endpoints.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-identifier": true},
    "key_prefix": {"type": "string", "minLength": 1, "maxLength": 16},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 50, "x-identifier": true},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-identifier": true},
    "project_id": {"type": ["string", "null"], "maxLength": 128, "x-identifier": true},
    "key_type": {"type": "string", "enum": ["user", "service", "admin", "temporary", "readonly", "system"]},
    "key_name": {"type": ["string", "null"], "maxLength": 255},
    "description": {"type": ["string", "null"], "maxLength": 1000},
    "status": {"type": "string", "enum": ["ACTIVE", "ROTATING", "REVOKED", "EXPIRED", "SUSPENDED"]},
    "version": {"type": "integer", "minimum": 1},
    "parent_key_id": {"type": ["string", "null"], "maxLength": 128, "x-identifier": true},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "scopes": {"type": "array", "items": {"type": "string"}},
    "rate_limit_tier": {"type": "string", "minLength": 1, "maxLength": 50},
    "custom_rate_limits": {"type": ["object", "null"]},
    "rotation_enabled": {"type": "boolean"},
    "rotation_interval_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "last_rotated_at": {"type": ["string", "null"], "format": "date-time"},
    "next_rotation_at": {"type": ["string", "null"], "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "last_used_at": {"type": ["string", "null"], "format": "date-time"},
    "usage_count": {"type": "integer", "minimum": 0},
    "created_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "is_active": {"type": "boolean"},
    "needs_rotation": {"type": "boolean"},
    "allowed_ips": {"type": ["array", "null"], "items": {"type": "string"}},
    "custom_metadata": {"type": ["object", "null"]},
    "last_used_ip": {"type": ["string", "null"], "maxLength": 45},
    "analytics": {"type": "object", "additionalProperties": true}
  },
  "required": ["id", "key_id", "key_prefix", "user_id", "tenant_id", "project_id", "key_type", "key_name", "description", "status", "version", "parent_key_id", "permissions", "scopes", "rate_limit_tier", "custom_rate_limits", "rotation_enabled", "rotation_interval_days", "last_rotated_at", "next_rotation_at", "expires_at", "last_used_at", "usage_count", "created_at", "updated_at", "is_active", "needs_rotation"]
}
