{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/auth/api_key_resource_schema.json",
  "title": "API Key Create Data",
  "description": "The data object returned by a successful API key create response.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "x-privacy-classification": "secret",
      "x-one-time-field": true,
      "x-privacy-note": "Returned only by a successful create response. Do not log, cache, export, or retransmit this value."
    },
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "x-identifier": true},
    "key_prefix": {"type": "string", "minLength": 1, "maxLength": 16},
    "key_name": {"type": ["string", "null"], "maxLength": 255},
    "key_type": {"type": "string", "enum": ["user", "service", "admin", "temporary", "readonly", "system"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "required": ["key", "key_id", "key_prefix", "key_name", "key_type", "created_at"]
}
