{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/certification/certificate_verification_materials_v0_schema.json",
  "title": "Agent Certificate v0 Verification Materials",
  "description": "A content-free discovery bundle for an already issued certificate. This is not an independent trust anchor and not freshness evidence: relying parties MUST obtain and pin issuer, client, register, verifier, and policy expectations independently. The bundle deliberately contains no nonce, expected_nonce, build_session_ref, tenant/project identifier, manifest digest, certificate status, revocation status, KMS identifier, semantics artifact, source, example, evaluator, blind, private key, or certificate body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "distribution_role",
    "requires_independent_pins",
    "certificate_ref",
    "issuer",
    "client",
    "relying_party_policy",
    "materials_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "traigent.certificate_verification_materials.v0"
    },
    "distribution_role": {
      "const": "discovery_only"
    },
    "requires_independent_pins": {
      "const": true
    },
    "certificate_ref": {
      "$ref": "certification_common_v0_schema.json#/definitions/OpaqueRef"
    },
    "issuer": {
      "$ref": "#/definitions/IssuerVerificationKeyV0"
    },
    "client": {
      "$ref": "#/definitions/ClientVerificationKeyV0"
    },
    "relying_party_policy": {
      "$ref": "#/definitions/RelyingPartyPolicyV0"
    },
    "materials_digest": {
      "description": "A role-separated digest over this exact bundle with materials_digest removed: sha256: plus lowercase SHA-256 of UTF8(traigent.agent_certificate.verification_materials.v0) || 0x00 || fp2.canonicalize(bundle_without_materials_digest). This is a pin/TOFU token, not a signature and not proof that the serving endpoint is trustworthy.",
      "$ref": "certification_common_v0_schema.json#/definitions/Sha256Digest"
    }
  },
  "definitions": {
    "CanonicalSpkiDerBase64V0": {
      "description": "Canonical standard RFC 4648 base64 of a bounded X.509 SubjectPublicKeyInfo DER public key. The schema constrains the alphabet, padding, and bounds; a verifier MUST additionally decode and validate the DER SPKI and declared algorithm, then re-encode to reject non-canonical aliases. Private-key encodings are not valid SPKI material.",
      "type": "string",
      "oneOf": [
        {
          "pattern": "^(?:[A-Za-z0-9+/]{4}){10,127}(?:[A-Za-z0-9+/]{2}==)$"
        },
        {
          "pattern": "^(?:[A-Za-z0-9+/]{4}){10,127}(?:[A-Za-z0-9+/]{3}=)$"
        },
        {
          "pattern": "^(?:[A-Za-z0-9+/]{4}){11,127}$"
        }
      ]
    },
    "PublicKeyProjectionV0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_ref",
        "algorithm",
        "public_key_der_b64",
        "public_key_digest"
      ],
      "properties": {
        "key_ref": {
          "$ref": "certification_common_v0_schema.json#/definitions/OpaqueRef"
        },
        "algorithm": {
          "enum": [
            "ed25519",
            "ecdsa_p256_sha256"
          ]
        },
        "public_key_der_b64": {
          "$ref": "#/definitions/CanonicalSpkiDerBase64V0"
        },
        "public_key_digest": {
          "$ref": "certification_common_v0_schema.json#/definitions/Sha256Digest"
        }
      }
    },
    "IssuerVerificationKeyV0": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_ref",
        "trust_ring_ref",
        "algorithm",
        "public_key_der_b64",
        "public_key_digest"
      ],
      "properties": {
        "key_ref": {
          "$ref": "certification_common_v0_schema.json#/definitions/OpaqueRef"
        },
        "trust_ring_ref": {
          "$ref": "certification_common_v0_schema.json#/definitions/OpaqueRef"
        },
        "algorithm": {
          "const": "ecdsa_p256_sha256"
        },
        "public_key_der_b64": {
          "$ref": "#/definitions/CanonicalSpkiDerBase64V0"
        },
        "public_key_digest": {
          "$ref": "certification_common_v0_schema.json#/definitions/Sha256Digest"
        }
      }
    },
    "ClientVerificationKeyV0": {
      "$ref": "#/definitions/PublicKeyProjectionV0"
    },
    "VerifierBindingV0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "verifier_ref", "verifier_version"],
      "properties": {
        "verifier_id": {
          "type": "string",
          "pattern": "^(D2|G1)$"
        },
        "verifier_ref": {
          "type": "string",
          "pattern": "^ver\\.cert\\.[a-z0-9_]{1,64}$"
        },
        "verifier_version": {
          "$ref": "certification_common_v0_schema.json#/definitions/BoundedSemver"
        }
      }
    },
    "RelyingPartyPolicyV0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler_register_versions", "verifier_bindings"],
      "properties": {
        "compiler_register_versions": {
          "$ref": "certification_common_v0_schema.json#/definitions/CompilerRegisterVersionsV0"
        },
        "verifier_bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false,
          "items": [
            {
              "allOf": [
                {
                  "$ref": "#/definitions/VerifierBindingV0"
                },
                {
                  "properties": {
                    "verifier_id": {
                      "const": "D2"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/VerifierBindingV0"
                },
                {
                  "properties": {
                    "verifier_id": {
                      "const": "G1"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}
