{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Correlation Summary",
  "description": "Closed summary of linking connector observations to optimization trials, produced customer-side. Code identity (function reference, repo-relative file path) is permitted; repository URLs and data identifiers are not.",
  "version": "1.0.0",
  "definitions": {
    "OpaqueToken": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{8,64}$",
      "description": "Per-connection opaque token minted customer-side. Never a raw platform identifier."
    },
    "TierCounts": {
      "type": "object",
      "properties": {
        "exact": {"type": "integer", "minimum": 0},
        "commit_name": {"type": "integer", "minimum": 0},
        "name_only": {"type": "integer", "minimum": 0},
        "deployment": {"type": "integer", "minimum": 0},
        "ambiguous": {"type": "integer", "minimum": 0}
      },
      "required": ["exact", "commit_name", "name_only", "deployment", "ambiguous"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "run_token": {"$ref": "#/definitions/OpaqueToken"},
    "trials_total": {"type": "integer", "minimum": 0},
    "trials_linked": {"type": "integer", "minimum": 0},
    "trials_unknown": {"type": "integer", "minimum": 0},
    "tier_counts": {"$ref": "#/definitions/TierCounts"},
    "agent_function_ref": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^[A-Za-z_][\\w.]*(:[\\w.<>]+)?$",
      "description": "Code identifier of the agent function, module.path[:qualname]. Code identity, not content."
    },
    "agent_file_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$))[^\\x00-\\x1f]+$",
      "description": "Repository-relative POSIX file path: not absolute, no '..' segment, no URL scheme or drive letter, no backslash."
    }
  },
  "required": ["schema_version", "run_token", "trials_total", "trials_linked", "trials_unknown", "tier_counts"],
  "additionalProperties": false
}
