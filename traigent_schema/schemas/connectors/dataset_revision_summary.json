{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dataset Revision Summary",
  "description": "Closed summary of one evaluation dataset revision bootstrapped from a connector, produced customer-side. Carries only counts, enums and opaque tokens; never item content, names or labels.",
  "version": "1.0.0",
  "definitions": {
    "OpaqueToken": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{8,64}$",
      "description": "Per-connection opaque token minted customer-side. Never a raw platform identifier."
    },
    "ConnectorKind": {
      "type": "string",
      "enum": ["langfuse", "bedrock", "traigent_cloud", "mlflow", "wandb", "langsmith", "n8n", "git_file"]
    },
    "SamplingPolicy": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["all", "random", "stratified", "first_n"]},
        "sample_size": {"type": "integer", "minimum": 0},
        "fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "seed": {"type": "integer"}
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ScoreSemantics": {
      "type": "object",
      "properties": {
        "score_token": {"$ref": "#/definitions/OpaqueToken"},
        "type": {"type": "string", "enum": ["numeric", "boolean", "categorical"]},
        "direction": {"type": "string", "enum": ["higher_better", "lower_better", "none"]}
      },
      "required": ["score_token", "type", "direction"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "dataset_token": {"$ref": "#/definitions/OpaqueToken"},
    "revision": {"type": "integer", "minimum": 1},
    "source_connector_kind": {"$ref": "#/definitions/ConnectorKind"},
    "item_count": {"type": "integer", "minimum": 0},
    "holdout_count": {"type": "integer", "minimum": 0},
    "approved": {"type": "boolean"},
    "approval_at": {"type": ["string", "null"], "format": "date-time"},
    "sampling_policy": {"$ref": "#/definitions/SamplingPolicy"},
    "score_semantics": {
      "type": "array",
      "items": {"$ref": "#/definitions/ScoreSemantics"},
      "maxItems": 256
    }
  },
  "required": ["schema_version", "dataset_token", "revision", "source_connector_kind", "item_count", "holdout_count", "approved", "sampling_policy", "score_semantics"],
  "additionalProperties": false
}
