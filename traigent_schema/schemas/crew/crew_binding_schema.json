{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_binding_schema.json",
  "title": "Crew Binding Result",
  "description": "`crew_binding` in the session-create response: closed status plus identifiers only. No names, keys or echoes of the declaration. Ids appear only when status = bound; crew_id may also appear for pending_portal and conflict. unknown/disabled carry no ids. Wire location: top-level `crew_binding` of the POST /api/v1/sessions 201 response (additive; the response root is open). Not referenced from the optimization documents for the same reason as crew_declaration_schema.json: the crew ids are not provable opaque refs under the optimization content-class lint.",
  "type": "object",
  "additionalProperties": {
    "not": {}
  },
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "$ref": "./crew_common_schema.json#/definitions/CrewBindingStatus"
    },
    "crew_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewId",
      "x-identifier": true,
      "description": "Present for bound, pending_portal and conflict."
    },
    "role_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRoleId",
      "x-identifier": true,
      "description": "Present only when bound."
    },
    "role_token": {
      "$ref": "./crew_common_schema.json#/definitions/RoleToken",
      "x-identifier": true,
      "description": "Present only when bound."
    },
    "crew_revision_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRevisionId",
      "x-identifier": true,
      "description": "Present only when bound."
    },
    "revision_no": {
      "type": "integer",
      "minimum": 1,
      "description": "Present only when bound."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "bound"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "crew_id",
          "role_id",
          "role_token",
          "crew_revision_id",
          "revision_no"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "pending_portal",
              "conflict"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "role_id": {
            "not": {}
          },
          "role_token": {
            "not": {}
          },
          "crew_revision_id": {
            "not": {}
          },
          "revision_no": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "disabled",
              "unknown"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "crew_id": {
            "not": {}
          },
          "role_id": {
            "not": {}
          },
          "role_token": {
            "not": {}
          },
          "crew_revision_id": {
            "not": {}
          },
          "revision_no": {
            "not": {}
          }
        }
      }
    }
  ]
}
