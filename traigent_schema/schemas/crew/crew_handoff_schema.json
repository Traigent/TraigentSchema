{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_handoff_schema.json",
  "title": "Crew Handoff",
  "description": "Contract only (slice 3, no API yet). One directed transfer of work between two roles inside a crew run. Carries counts and enums only, never message content. Not related to agent_handoff (team-ownership transfer).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crew_run_id",
    "hop_seq",
    "from_role_token",
    "to_role_token",
    "from_invocation_id",
    "to_invocation_id",
    "requested_at",
    "entered",
    "dedup_id",
    "transfer_status",
    "context_truncated"
  ],
  "properties": {
    "crew_run_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRunId",
      "x-identifier": true,
      "description": "Parent crew run."
    },
    "hop_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "1-based; allocated by the sender from the baggage hop counter; unique per crew run."
    },
    "from_role_token": {
      "$ref": "./crew_common_schema.json#/definitions/RoleToken",
      "x-identifier": true,
      "description": "Sending role."
    },
    "to_role_token": {
      "$ref": "./crew_common_schema.json#/definitions/RoleToken",
      "x-identifier": true,
      "description": "Receiving role."
    },
    "from_invocation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "x-identifier": true,
      "description": "Sending invocation."
    },
    "to_invocation_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "x-identifier": true,
      "description": "Receiving invocation; null if the transfer was never entered."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "entered": {
      "type": "boolean",
      "description": "True when the receiving role was actually entered. A handoff is counted when requested; a loop is counted when entered (RFC counters)."
    },
    "dedup_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "x-identifier": true,
      "description": "Replay key; ingest is idempotent per (crew_run_id, dedup_id)."
    },
    "transfer_status": {
      "$ref": "./crew_common_schema.json#/definitions/TransferStatus"
    },
    "hop_latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Latency of the hop, ms."
    },
    "inherited_context_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Context tokens carried over from earlier hops."
    },
    "added_context_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Context tokens added at this hop."
    },
    "context_truncated": {
      "type": "boolean",
      "description": "True when context was truncated at this hop."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "entered": {
            "const": true
          }
        },
        "required": [
          "entered"
        ]
      },
      "then": {
        "properties": {
          "to_invocation_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entered": {
            "const": false
          }
        },
        "required": [
          "entered"
        ]
      },
      "then": {
        "properties": {
          "to_invocation_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
