{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_response_schema.json",
  "title": "Crew Response",
  "description": "200/201 body of create, get and archive crew. get additionally lists roles.",
  "type": "object",
  "x-wrap-status": "wrapped",
  "additionalProperties": false,
  "required": [
    "success",
    "message",
    "data"
  ],
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "message": {
      "type": "string",
      "maxLength": 200
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crew_id",
        "crew_key",
        "name",
        "description",
        "archived_at",
        "created_by",
        "created_at",
        "updated_at",
        "latest_revision_no",
        "roles"
      ],
      "properties": {
        "crew_id": {
          "$ref": "./crew_common_schema.json#/definitions/CrewId",
          "x-identifier": true,
          "description": "Opaque immutable crew id."
        },
        "crew_key": {
          "$ref": "./crew_common_schema.json#/definitions/CrewKey",
          "x-content": true,
          "x-privacy-classification": "user_content",
          "description": "Immutable registration key. CONTENT."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-content": true,
          "x-privacy-classification": "user_content",
          "description": "Mutable display name. CONTENT."
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "x-content": true,
          "x-privacy-classification": "user_content",
          "description": "Mutable description. CONTENT."
        },
        "archived_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "x-identifier": true,
          "description": "Opaque user id."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "latest_revision_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Highest revision_no, null when the crew has no revision yet."
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "./crew_role_schema.json"
          }
        }
      }
    }
  }
}
