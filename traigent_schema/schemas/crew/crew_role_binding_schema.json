{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_role_binding_schema.json",
  "title": "Crew Role Binding",
  "description": "Binding of a role to an agent (or unit) inside one crew revision. Key (crew_revision_id, role_id). Table crew_role_bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crew_revision_id",
    "role_id",
    "binding_kind",
    "agent_id",
    "unit_ref",
    "pinned_agent_digest",
    "entry",
    "state",
    "provenance"
  ],
  "properties": {
    "crew_revision_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRevisionId",
      "x-identifier": true,
      "description": "Revision this binding belongs to."
    },
    "role_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRoleId",
      "x-identifier": true,
      "description": "Role being bound."
    },
    "binding_kind": {
      "$ref": "./crew_common_schema.json#/definitions/BindingKind"
    },
    "agent_id": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/AgentId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Bound agent; null only while state is unbound or for agent_unit rows."
    },
    "unit_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "description": "Reserved (slice 4): versioned unit reference. Must be null in slices 1-3; a code identifier (GNFR-PRIV-003), never a display name."
    },
    "pinned_agent_digest": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/Sha256Digest"
        },
        {
          "type": "null"
        }
      ],
      "description": "Pinned agent build/config digest; null = follow the agent's latest."
    },
    "entry": {
      "type": "boolean",
      "description": "Entry role flag. At most one true per revision; exactly one is required before execution features."
    },
    "state": {
      "$ref": "./crew_common_schema.json#/definitions/BindingState"
    },
    "provenance": {
      "$ref": "./crew_common_schema.json#/definitions/BindingProvenance"
    }
  }
}
