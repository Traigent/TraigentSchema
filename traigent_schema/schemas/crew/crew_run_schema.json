{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_run_schema.json",
  "title": "Crew Run",
  "description": "Contract only (slice 3, no API yet). One end-to-end execution of a crew revision for one input. Totals are exclusive (additive) sums over member executions; unknown stays null. Metrics aggregate by crew_run membership, never by agent_id IN crew.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crew_run_id",
    "crew_id",
    "crew_revision_id",
    "status",
    "completeness",
    "entry_role_token",
    "hop_count",
    "loop_count",
    "halted_by_policy",
    "halt_reason",
    "started_at"
  ],
  "properties": {
    "crew_run_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRunId",
      "x-identifier": true,
      "description": "SDK-minted UUIDv7."
    },
    "crew_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewId",
      "x-identifier": true,
      "description": "Crew."
    },
    "crew_revision_id": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/CrewRevisionId"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true,
      "description": "Revision executed; null only when completeness != complete."
    },
    "experiment_run_id": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/ExperimentRunId"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true
    },
    "configuration_run_id": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/ConfigurationRunId"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true
    },
    "scenario_ref": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/ScenarioRef"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true
    },
    "replicate": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "$ref": "./crew_common_schema.json#/definitions/RunStatus"
    },
    "completeness": {
      "$ref": "./crew_common_schema.json#/definitions/RunCompleteness"
    },
    "entry_role_token": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/RoleToken"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true,
      "description": "Entry role; null only when completeness != complete."
    },
    "hop_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of handoffs."
    },
    "loop_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of detected loops."
    },
    "wall_clock_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Wall clock, ms."
    },
    "exclusive_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Sum of member exclusive cost."
    },
    "exclusive_latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Sum of member exclusive latency."
    },
    "exclusive_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Sum of member exclusive input tokens."
    },
    "exclusive_output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Sum of member exclusive output tokens."
    },
    "halted_by_policy": {
      "type": "boolean"
    },
    "halt_reason": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/HaltReason"
        },
        {
          "type": "null"
        }
      ],
      "description": "Required non-null iff halted_by_policy is true."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "complete"
          }
        },
        "required": [
          "completeness"
        ]
      },
      "then": {
        "properties": {
          "crew_revision_id": {
            "type": "string"
          },
          "entry_role_token": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "halted_by_policy": {
            "const": true
          }
        },
        "required": [
          "halted_by_policy"
        ]
      },
      "then": {
        "properties": {
          "halt_reason": {
            "$ref": "./crew_common_schema.json#/definitions/HaltReason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "halted_by_policy": {
            "const": false
          }
        },
        "required": [
          "halted_by_policy"
        ]
      },
      "then": {
        "properties": {
          "halt_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
