{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_schema.json",
  "title": "Crew",
  "description": "A named set of agents that cooperate on one job. Table crews; tenant_id/project_id come from the canonical auth context and are not wire fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crew_id",
    "crew_key",
    "name",
    "description",
    "archived_at",
    "created_by",
    "created_at",
    "updated_at",
    "latest_revision_no",
    "latest_revision_id",
    "role_count",
    "bound_member_count",
    "entry_role_id"
  ],
  "properties": {
    "crew_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewId",
      "x-identifier": true,
      "description": "Opaque immutable crew id."
    },
    "crew_key": {
      "$ref": "./crew_common_schema.json#/definitions/CrewKey",
      "x-content": true,
      "x-privacy-classification": "user_content",
      "description": "Immutable registration key. CONTENT."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-content": true,
      "x-privacy-classification": "user_content",
      "description": "Mutable display name. CONTENT."
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000,
      "x-content": true,
      "x-privacy-classification": "user_content",
      "description": "Mutable description. CONTENT."
    },
    "archived_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "x-identifier": true,
      "description": "Opaque user id."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "latest_revision_no": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Highest revision_no, null when the crew has no revision yet."
    },
    "latest_revision_id": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/CrewRevisionId"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true,
      "description": "Opaque id of the latest revision (the revision latest_revision_no names); null when the crew has no revision yet. Read in one query with the summary counts."
    },
    "role_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of roles of the crew."
    },
    "bound_member_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Distinct agent_ids bound (state=bound) in the latest revision; 0 when the crew has no revision."
    },
    "entry_role_id": {
      "anyOf": [
        {
          "$ref": "./crew_common_schema.json#/definitions/CrewRoleId"
        },
        {
          "type": "null"
        }
      ],
      "x-identifier": true,
      "description": "Entry role of the latest revision; null when none or no revision."
    }
  }
}
