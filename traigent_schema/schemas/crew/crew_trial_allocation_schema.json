{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/crew/crew_trial_allocation_schema.json",
  "title": "Crew Trial Allocation",
  "description": "Contract only (slice 4, no API yet). Which member config each role ran in one configuration run: configuration_run_id -> role_token -> member config digest. Identifiers and digests only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configuration_run_id",
    "crew_id",
    "crew_revision_id",
    "role_token",
    "member_config_digest"
  ],
  "properties": {
    "configuration_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "x-identifier": true
    },
    "crew_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewId",
      "x-identifier": true,
      "description": "Crew."
    },
    "crew_revision_id": {
      "$ref": "./crew_common_schema.json#/definitions/CrewRevisionId",
      "x-identifier": true,
      "description": "Revision."
    },
    "role_token": {
      "$ref": "./crew_common_schema.json#/definitions/RoleToken",
      "x-identifier": true,
      "description": "Role."
    },
    "member_config_digest": {
      "$ref": "./crew_common_schema.json#/definitions/Sha256Digest"
    }
  }
}
