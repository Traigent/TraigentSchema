{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/evaluation_system_validation/evaluation_system_reviewer_grant_schema.json",
  "title": "Evaluation System Reviewer Grant",
  "description": "Closed, append-only capability-grant contract for the evaluation_system_reviewer capability. Project role alone (including admin) never confers signing; only an active grant does. A withdrawal is a 'revocation' record naming the grant it revokes. The grantor and time are always server-derived.",
  "definitions": {
    "OpaqueId": {
      "$ref": "https://schemas.traigent.ai/agent_readiness/agent_readiness_common_schema.json#/definitions/OpaqueId"
    },
    "RecordKind": {
      "type": "string",
      "enum": ["grant", "revocation"]
    },
    "Capability": {
      "type": "string",
      "enum": ["evaluation_system_reviewer"]
    },
    "GrantPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "principal_kind": {"const": "USER"},
        "principal_ref": {
          "$ref": "#/definitions/OpaqueId",
          "description": "The user id, or the literal string 'erased' after account erasure."
        }
      },
      "required": ["principal_kind", "principal_ref"]
    },
    "ReviewerGrantCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_kind", "grantee_user_id", "revokes", "reason"],
      "properties": {
        "record_kind": {"$ref": "#/definitions/RecordKind"},
        "grantee_user_id": {
          "oneOf": [{"$ref": "#/definitions/OpaqueId"}, {"type": "null"}]
        },
        "revokes": {
          "oneOf": [{"$ref": "#/definitions/OpaqueId"}, {"type": "null"}]
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {
          "if": {"properties": {"record_kind": {"const": "grant"}}},
          "then": {
            "properties": {
              "grantee_user_id": {"$ref": "#/definitions/OpaqueId"},
              "revokes": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"record_kind": {"const": "revocation"}}},
          "then": {
            "properties": {
              "grantee_user_id": {"type": "null"},
              "revokes": {"$ref": "#/definitions/OpaqueId"}
            }
          }
        }
      ]
    },
    "ReviewerGrantRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "record_kind",
        "capability",
        "grantee",
        "granted_by",
        "self_granted",
        "reason",
        "recorded_at",
        "revokes",
        "revoked_by",
        "observation_basis"
      ],
      "properties": {
        "grant_id": {"$ref": "#/definitions/OpaqueId"},
        "record_kind": {"$ref": "#/definitions/RecordKind"},
        "capability": {"$ref": "#/definitions/Capability"},
        "grantee": {
          "$ref": "#/definitions/GrantPrincipal",
          "description": "The reviewer this capability grant is about. On BOTH a grant row and its revocation row, this identifies the same person -- the one who can (grant) or can no longer (revocation) sign."
        },
        "granted_by": {
          "$ref": "#/definitions/GrantPrincipal",
          "description": "The actor who WROTE this row: on a grant record, the grantor; on a revocation record, the revoker (who may differ from the original grantor -- any project admin can revoke, not only the one who granted). Never recomputed; each row states its own writer."
        },
        "self_granted": {
          "type": "boolean",
          "description": "Stored once at write time, never recomputed on read. On a grant record: true iff granted_by.principal_ref == grantee.principal_ref at the moment this record was written (owner ruling: a project admin may grant the capability to themselves; the wire always discloses when they did). On a revocation record: an immutable COPY of the ORIGINAL grant's self_granted value (not the revoker's relationship to the grantee) -- so the audit trail keeps saying 'this capability was self-granted' even after someone else revokes it."
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "recorded_at": {"type": "string", "format": "date-time"},
        "revokes": {
          "oneOf": [{"$ref": "#/definitions/OpaqueId"}, {"type": "null"}]
        },
        "revoked_by": {
          "oneOf": [{"$ref": "#/definitions/OpaqueId"}, {"type": "null"}],
          "description": "Computed on read from the revocation row (never stored on the original row, which stays immutable)."
        },
        "observation_basis": {"const": "backend_observed"}
      },
      "allOf": [
        {
          "if": {"properties": {"record_kind": {"const": "grant"}}},
          "then": {"properties": {"revokes": {"type": "null"}}}
        },
        {
          "if": {"properties": {"record_kind": {"const": "revocation"}}},
          "then": {
            "properties": {
              "revokes": {"$ref": "#/definitions/OpaqueId"},
              "revoked_by": {"type": "null"}
            }
          }
        }
      ]
    },
    "ReviewerGrantListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "items", "pagination"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/definitions/ReviewerGrantRecord"}
        },
        "pagination": {
          "allOf": [
            {"$ref": "../pagination_schema.json"},
            {"properties": {"per_page": {"maximum": 100}}}
          ]
        }
      }
    },
    "ReviewerCapabilityReasonCode": {
      "type": "string",
      "enum": ["NO_ACTIVE_GRANT", "API_KEY_PRINCIPAL"],
      "description": "Reasons available in a 200 body: the caller reached the handler with at least project read access, so the only remaining question is grant/principal shape. Lack of project access is NOT a value here -- the route itself returns 403 (the finite agent_readiness_error_schema.json envelope) before this response is ever built, so a NO_PROJECT_ACCESS body-level code would be dead code on the wire (captain decision: smaller change than removing the /me 403)."
    },
    "ReviewerCanSignResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_sign", "cannot_sign_reason", "grant_id"],
      "properties": {
        "can_sign": {"type": "boolean"},
        "cannot_sign_reason": {
          "oneOf": [
            {"$ref": "#/definitions/ReviewerCapabilityReasonCode"},
            {"type": "null"}
          ]
        },
        "grant_id": {
          "oneOf": [{"$ref": "#/definitions/OpaqueId"}, {"type": "null"}]
        }
      },
      "oneOf": [
        {
          "properties": {
            "can_sign": {"const": true},
            "cannot_sign_reason": {"type": "null"},
            "grant_id": {"$ref": "#/definitions/OpaqueId"}
          }
        },
        {
          "properties": {
            "can_sign": {"const": false},
            "cannot_sign_reason": {"$ref": "#/definitions/ReviewerCapabilityReasonCode"},
            "grant_id": {"type": "null"}
          }
        }
      ]
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/ReviewerGrantCreateRequest"},
    {"$ref": "#/definitions/ReviewerGrantRecord"},
    {"$ref": "#/definitions/ReviewerGrantListResponse"},
    {"$ref": "#/definitions/ReviewerCanSignResponse"}
  ]
}
