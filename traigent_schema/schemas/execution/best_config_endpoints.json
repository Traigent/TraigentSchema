{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Cloud Best Config Routes",
    "version": "1.0.0",
    "description": "Backend routes for publishing, fetching, listing, and rolling back promoted runtime best configs."
  },
  "paths": {
    "/api/v1/best-configs": {
      "get": {
        "summary": "List current cloud best configs",
        "parameters": [
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "../optimization/best_config_schema.json#/definitions/best_config_environment"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Best configs retrieved successfully"
          },
          "429": {
            "description": "Too many requests — rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Publish current cloud best config",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "description": "For ordinary publish, use the current ETag when changing an existing configuration. Omit for a new configuration. The same spec returns the current version even with a stale If-Match.",
            "schema": {
              "x-content-class": "auth_header",
              "type": "string"
            }
          },
          {
            "name": "X-Traigent-Agent-Ref",
            "in": "header",
            "required": false,
            "description": "Opaque agent reference for a head-move request. Pair with X-Traigent-Expected-Head-Generation and omit X-Traigent-Agent-Id. To publish a configuration, omit all three head headers.",
            "schema": {
              "$ref": "../labels/label_common_schema.json#/definitions/AgentRef"
            }
          },
          {
            "name": "X-Traigent-Expected-Head-Generation",
            "in": "header",
            "required": false,
            "description": "Expected generation in a head-move request, sent with exactly one of X-Traigent-Agent-Id or X-Traigent-Agent-Ref. Publish refuses these requests before comparing a head generation.",
            "schema": {
              "x-content-class": "number",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./best_config_publish_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing best config returned or updated"
          },
          "201": {
            "description": "Best config published successfully"
          },
          "400": {
            "description": "Invalid head headers return AGENT_HEAD_VALIDATION_ERROR with success false and the same fixed validation text in error and message. Ordinary publish validation failures and empty JSON on a head-move request return BEST_CONFIG_VALIDATION_ERROR with the same validation text in error and message. Request guards can return a provider credential problem document, an unsupported content type error, or an idempotency request error before the route.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "success": {
                      "x-content-class": "closed_enum",
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "$ref": "../error_envelope_schema.json#/properties/error"
                    },
                    "error_code": {
                      "$ref": "../error_envelope_schema.json#/properties/error_code"
                    },
                    "message": {
                      "$ref": "../error_envelope_schema.json#/properties/message"
                    },
                    "allowed_content_types": {
                      "x-content-class": "closed_enum",
                      "const": [
                        "application/json",
                        "application/x-protobuf",
                        "application/x-www-form-urlencoded",
                        "multipart/form-data",
                        "text/plain"
                      ]
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "oneOf": [
                    {
                      "x-content-class": "closed_enum",
                      "enum": [
                        {
                          "success": false,
                          "error": "X-Traigent-Agent-Id and X-Traigent-Agent-Ref must not be sent together",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "X-Traigent-Agent-Id and X-Traigent-Agent-Ref must not be sent together"
                        },
                        {
                          "success": false,
                          "error": "X-Traigent-Expected-Head-Generation and one of X-Traigent-Agent-Id or X-Traigent-Agent-Ref must be sent together",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "X-Traigent-Expected-Head-Generation and one of X-Traigent-Agent-Id or X-Traigent-Agent-Ref must be sent together"
                        },
                        {
                          "success": false,
                          "error": "X-Traigent-Expected-Head-Generation must be a non-negative integer",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "X-Traigent-Expected-Head-Generation must be a non-negative integer"
                        },
                        {
                          "success": false,
                          "error": "X-Traigent-Expected-Head-Generation must be at most 9007199254740991",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "X-Traigent-Expected-Head-Generation must be at most 9007199254740991"
                        },
                        {
                          "success": false,
                          "error": "agent id must be a non-empty string",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "agent id must be a non-empty string"
                        },
                        {
                          "success": false,
                          "error": "agent id is too long",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "agent id is too long"
                        },
                        {
                          "success": false,
                          "error": "X-Traigent-Agent-Ref is malformed",
                          "error_code": "AGENT_HEAD_VALIDATION_ERROR",
                          "message": "X-Traigent-Agent-Ref is malformed"
                        }
                      ]
                    },
                    {
                      "description": "For BEST_CONFIG_VALIDATION_ERROR, the service sets error and message to the same text.",
                      "allOf": [
                        {
                          "$ref": "../error_envelope_schema.json"
                        },
                        {
                          "properties": {
                            "error_code": {
                              "x-content-class": "closed_enum",
                              "const": "BEST_CONFIG_VALIDATION_ERROR"
                            }
                          },
                          "required": [
                            "error_code"
                          ],
                          "not": {
                            "required": [
                              "details"
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "x-content-class": "closed_enum",
                      "enum": [
                        {
                          "error": "Invalid Idempotency-Key",
                          "message": "Key too long"
                        },
                        {
                          "error": "Invalid idempotent request",
                          "message": "Unable to fingerprint request body"
                        },
                        {
                          "error": "Bad Request",
                          "message": "Invalid request format or content type",
                          "allowed_content_types": [
                            "application/json",
                            "application/x-protobuf",
                            "application/x-www-form-urlencoded",
                            "multipart/form-data",
                            "text/plain"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "examples": {
                  "emptyHeadMoveBody": {
                    "value": {
                      "success": false,
                      "error": "request body must contain JSON",
                      "error_code": "BEST_CONFIG_VALIDATION_ERROR",
                      "message": "request body must contain JSON"
                    }
                  }
                }
              },
              "application/problem+json": {
                "schema": {
                  "x-content-class": "closed_enum",
                  "const": {
                    "type": "urn:traigent:problem:provider_credential_not_accepted",
                    "title": "Provider credentials are not accepted",
                    "status": 400,
                    "code": "provider_credential_not_accepted",
                    "detail": "Provider credentials are not accepted by the API. Configure them in the deployment environment or secret storage.",
                    "success": false,
                    "error": "provider_credential_not_accepted",
                    "error_code": "provider_credential_not_accepted",
                    "message": "Provider credentials are not accepted by the API. Configure them in the deployment environment or secret storage."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or authentication failed. The shared authentication guards return their usual error responses regardless of the publish headers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../optimization/best_config_publish_401_schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Permission, project role or scope denied by the shared guards. Agent-specific denials on a syntactically valid head-move request use the masked 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../optimization/best_config_publish_403_schema.json"
                }
              }
            }
          },
          "404": {
            "description": "An inaccessible or out-of-scope agent on a head-move request returns the masked ReleaseRefusal with reference_not_found and omits ETag and X-Traigent-Head-Generation. The ordinary publish can also return BEST_CONFIG_NOT_FOUND, and scope checks can independently return 404.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "success": {
                      "x-content-class": "closed_enum",
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "$ref": "../error_envelope_schema.json#/properties/error"
                    },
                    "error_code": {
                      "$ref": "../error_envelope_schema.json#/properties/error_code"
                    },
                    "message": {
                      "$ref": "../error_envelope_schema.json#/properties/message"
                    }
                  },
                  "required": [
                    "success",
                    "error",
                    "error_code",
                    "message"
                  ],
                  "oneOf": [
                    {
                      "allOf": [
                        {
                          "$ref": "../optimization/release_acceptance_schema.json#/definitions/ReleaseRefusal"
                        },
                        {
                          "properties": {
                            "error_code": {
                              "x-content-class": "closed_enum",
                              "const": "reference_not_found"
                            }
                          },
                          "required": [
                            "error_code"
                          ]
                        }
                      ]
                    },
                    {
                      "x-content-class": "closed_enum",
                      "enum": [
                        {
                          "success": false,
                          "error": "best config not found",
                          "error_code": "BEST_CONFIG_NOT_FOUND",
                          "message": "best config not found"
                        },
                        {
                          "success": false,
                          "error": "PROJECT_NOT_FOUND",
                          "error_code": "PROJECT_NOT_FOUND",
                          "message": "project not found"
                        },
                        {
                          "success": false,
                          "error": "TENANT_NOT_FOUND",
                          "error_code": "TENANT_NOT_FOUND",
                          "message": "requested tenant does not exist"
                        },
                        {
                          "success": false,
                          "error": "TENANT_NOT_FOUND",
                          "error_code": "TENANT_NOT_FOUND",
                          "message": "configured deployment tenant does not exist"
                        },
                        {
                          "success": false,
                          "error": "write scope project not found for tenant",
                          "error_code": "PROJECT_CONTEXT_REQUIRED",
                          "message": "write scope project not found for tenant"
                        },
                        {
                          "success": false,
                          "error": "RESOURCE_NOT_FOUND",
                          "error_code": "RESOURCE_NOT_FOUND",
                          "message": "Resource not found"
                        },
                        {
                          "success": false,
                          "error": "TENANT_NOT_FOUND",
                          "error_code": "TENANT_NOT_FOUND",
                          "message": "Tenant context is invalid for this request"
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Sent on the head-move refusal.",
                "schema": {
                  "x-content-class": "closed_enum",
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "Vary": {
                "description": "Head-move refusals vary by Authorization. CORS can append Origin or set Vary to Origin on other responses.",
                "schema": {
                  "x-content-class": "closed_enum",
                  "type": "string",
                  "enum": [
                    "Authorization",
                    "Authorization, Origin",
                    "Origin"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Head-move request for an authorized agent returns ReleaseRefusal with acceptance_required and omits ETag and X-Traigent-Head-Generation. Ordinary publish can return BEST_CONFIG_CONFLICT for an If-Match or function_ref conflict or a concurrent write conflict. A keyed request can also get an idempotency conflict or an in-progress response. A fingerprint conflict can occur before route-level head-header validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../optimization/best_config_publish_409_schema.json"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Sent on the head-move refusal.",
                "schema": {
                  "x-content-class": "closed_enum",
                  "const": "private, no-store",
                  "type": "string"
                }
              },
              "Vary": {
                "description": "Head-move refusals vary by Authorization. CORS can append Origin or set Vary to Origin on other responses.",
                "schema": {
                  "x-content-class": "closed_enum",
                  "type": "string",
                  "enum": [
                    "Authorization",
                    "Authorization, Origin",
                    "Origin"
                  ]
                }
              },
              "Retry-After": {
                "description": "Seconds before retrying an in-progress request with the same Idempotency-Key, when a lease duration is configured.",
                "schema": {
                  "x-content-class": "number",
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "413": {
            "description": "The request exceeds the configured body limit or has an invalid declared length.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "x-content-class": "closed_enum",
                      "const": {
                        "error": "Request body too large",
                        "code": "REQUEST_BODY_TOO_LARGE"
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "error",
                        "message",
                        "max_size"
                      ],
                      "properties": {
                        "error": {
                          "x-content-class": "closed_enum",
                          "const": "Request Too Large"
                        },
                        "message": {
                          "description": "Fixed phrase with the configured maximum request size in bytes.",
                          "allOf": [
                            {
                              "$ref": "../error_envelope_schema.json#/properties/message"
                            },
                            {
                              "not": {
                                "pattern": "^(?!Request size exceeds maximum allowed size of [0-9]+ bytes(?![\\s\\S]))"
                              }
                            }
                          ]
                        },
                        "max_size": {
                          "x-content-class": "number",
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "x-content-class": "closed_enum",
                      "enum": [
                        {
                          "success": false,
                          "error": "Request Entity Too Large",
                          "code": "REQUEST_ENTITY_TOO_LARGE"
                        },
                        {
                          "success": false,
                          "error": "Content Too Large",
                          "code": "REQUEST_ENTITY_TOO_LARGE"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "A request guard rejected an unsafe JSON string, or the request scope could not be resolved."
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected publish failure returns BEST_CONFIG_ERROR. Shared request guards, response hardening, transaction commit and the global error handler can also return 500.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../optimization/best_config_publish_500_schema.json"
                }
              }
            }
          },
          "501": {
            "description": "Best-config publishing is unavailable when the integration feature is disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "x-content-class": "closed_enum",
                  "enum": [
                    {
                      "success": false,
                      "error": "Traigent Integration feature not implemented",
                      "message": "The 'traigent_integration' feature is disabled in local mode",
                      "error_code": "FEATURE_DISABLED",
                      "feature": "traigent_integration",
                      "upgrade_message": "This feature is available in our cloud platform. Contact us to upgrade.",
                      "local_mode": true
                    },
                    {
                      "success": false,
                      "error": "Traigent Integration feature not implemented",
                      "message": "The 'traigent_integration' feature is disabled in local mode",
                      "error_code": "FEATURE_DISABLED",
                      "feature": "traigent_integration",
                      "upgrade_message": "This feature is available in our cloud platform. Contact us to upgrade.",
                      "local_mode": false
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The publish audit write failed, or a shared request service is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "x-content-class": "closed_enum",
                  "enum": [
                    {
                      "success": false,
                      "error": "Internal server error",
                      "error_code": "BEST_CONFIG_AUDIT_ERROR",
                      "message": "Internal server error"
                    },
                    {
                      "success": false,
                      "error": "Internal server error",
                      "error_code": "AUTH_BACKEND_UNAVAILABLE",
                      "message": "Internal server error"
                    },
                    {
                      "success": false,
                      "error": "Internal server error",
                      "error_code": "RATE_LIMIT_UNAVAILABLE",
                      "message": "Internal server error"
                    },
                    {
                      "success": false,
                      "error": "Authentication temporarily unavailable",
                      "error_code": "AUTH_BACKEND_UNAVAILABLE",
                      "message": "Authentication is temporarily unavailable"
                    },
                    {
                      "success": false,
                      "error": "AUTH_BACKEND_UNAVAILABLE",
                      "error_code": "AUTH_BACKEND_UNAVAILABLE",
                      "message": "Authentication temporarily unavailable"
                    },
                    {
                      "error": "Idempotency unavailable",
                      "message": "Stored idempotent response is unreadable"
                    },
                    {
                      "error": "Idempotency unavailable",
                      "message": "Unable to reserve idempotency lease for billable request"
                    },
                    {
                      "error": "Idempotency unavailable",
                      "message": "Unable to finalize idempotency record"
                    },
                    {
                      "success": false,
                      "error": "Internal server error",
                      "code": "INTERNAL_ERROR"
                    }
                  ]
                }
              }
            }
          }
        },
        "description": "Publish never moves the head. When X-Traigent-Agent-Id, X-Traigent-Agent-Ref and X-Traigent-Expected-Head-Generation are all absent, this is an ordinary publish. For a new configuration, omit If-Match. For a changed existing configuration, send the current ETag as If-Match. An identical spec returns the current version even with a stale If-Match.\n\nThe presence of any of the three head headers, including an empty value, requests a head move. Send exactly one of X-Traigent-Agent-Id or X-Traigent-Agent-Ref together with X-Traigent-Expected-Head-Generation for a syntactically valid head-move request. The agent ID must be non-empty and at most 512 characters after trimming. The agent ref must be agentref_ followed by 32 lowercase hex digits. The expected generation must be 1 to 16 decimal digits with a value from 0 through 9007199254740991.\n\nBefore the route, malformed JSON and some unsafe strings can be refused with 400. The idempotency check runs before the separate unsafe-JSON-string guard that can return 422, and before the route checks head headers. If a reused Idempotency-Key has a different request fingerprint, including added, changed or removed head headers, it can return 409 before those later checks.\n\nAuthentication, experiment.write permission, editor role and an explicit tenant and project write scope gate the route. In the route, incomplete, conflicting or malformed head headers return 400 AGENT_HEAD_VALIDATION_ERROR before agent authorization. An empty JSON body that reaches the head-move handler returns 400 BEST_CONFIG_VALIDATION_ERROR after header validation and before the agent decision.\n\nAn unknown agent, an agent outside the request's tenant and project, an opaque reference that cannot be resolved in that scope, or a caller without agent write access receives the same 404 reference_not_found. Where per-owner access applies, an agent whose creator is missing or differs from the caller also receives that 404. Per-owner access applies to non-platform-admin callers in the shared default tenant on an unpinned deployment. In an explicitly scoped collaboration project, an editor with agent write access can receive 409 acceptance_required for an agent created by another member. An agent the caller is authorized to write returns 409 acceptance_required. The agent decision precedes configuration validation. Neither refusal publishes a configuration or version or changes the head or head history. Both refusals set Cache-Control: private, no-store and Vary: Authorization, and omit ETag and X-Traigent-Head-Generation. The cross-origin response can also vary by Origin.\n\nA retry of a refused request with the same Idempotency-Key may return an idempotency 409 instead of the refusal. It never returns a success.\n\nTo move an agent's head, publish without the head headers, record a person's release acceptance with best_configs.create_release_acceptance, then call best_configs.release_agent_head."
      }
    },
    "/api/v1/best-configs/{config_id}": {
      "get": {
        "summary": "Fetch current cloud best config",
        "parameters": [
          {
            "name": "config_id",
            "in": "path",
            "required": true,
            "schema": {
              "x-content-class": "legacy_content",
              "x-content-note": "INV B2 (OPEN): config_id (customer-chosen configuration id; the spec.config_id of the publish)",
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Return 304 when the current best config ETag matches this value.",
            "schema": {
              "x-content-class": "auth_header",
              "type": "string"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "../optimization/best_config_schema.json#/definitions/best_config_environment"
            }
          },
          {
            "name": "function_ref",
            "in": "query",
            "required": false,
            "schema": {
              "x-content-class": "legacy_content",
              "x-content-note": "INV B2 (OPEN): function_ref (a code identifier, but the schema carries no identifier pattern to prove it)",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Best config retrieved successfully"
          },
          "304": {
            "description": "Cached best config is current"
          },
          "404": {
            "description": "Best config not found"
          },
          "429": {
            "description": "Too many requests — rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/best-configs/{config_id}/versions": {
      "get": {
        "summary": "List immutable cloud best-config versions",
        "responses": {
          "200": {
            "description": "Best config versions retrieved successfully"
          },
          "429": {
            "description": "Too many requests — rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/best-configs/{config_id}/rollback": {
      "post": {
        "summary": "Rollback current best config to a previous immutable version",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Current best-config ETag required to publish a rollback version.",
            "schema": {
              "x-content-class": "auth_header",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./best_config_rollback_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Best config rollback published successfully"
          },
          "409": {
            "description": "Rollback precondition failed"
          },
          "429": {
            "description": "Too many requests — rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
