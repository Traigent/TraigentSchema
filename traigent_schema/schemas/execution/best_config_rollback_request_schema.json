{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/execution/best_config_rollback_request_schema.json",
  "title": "Rollback Cloud Best Config Request",
  "description": "Request body for promoting a previous immutable cloud best-config version as the current version.",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "x-content-class": "number",
      "type": "integer",
      "minimum": 1
    },
    "environment": {
      "$ref": "../optimization/best_config_schema.json#/definitions/best_config_environment"
    },
    "metadata": {
      "x-content-class": "legacy_content",
      "x-content-key-class": "legacy_content",
      "x-content-note": "INV R82 (LEAK): metadata (free-form object, up to 64 keys)",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "x-content-class": "legacy_content",
        "x-content-note": "INV R82 (LEAK): metadata (free-form object, up to 64 keys): keys",
        "not": {
          "enum": [
            "tenant_id",
            "project_id",
            "promoted_by",
            "published_by",
            "published_by_user_id",
            "published_by_api_key_id"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
