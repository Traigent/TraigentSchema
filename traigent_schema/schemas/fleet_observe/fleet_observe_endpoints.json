{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent API Fleet Observe Routes (project level)",
    "version": "1.0.0",
    "description": "Fleet Observe v1 routes (TRAIG-179), grounded in the API server. Tenant and project come from the canonical context, never a header or the body. Errors are closed. The route wrapper rewrites only 403 and 404 to the closed 404; a 401 from the shared authentication layer keeps its status and is declared. The platform masks unhandled 5xx and the limiter's fail-closed 503 to a generic body. Customer-chosen names are content and are not accepted: digests only."
  },
  "paths": {
    "/api/v1beta/projects/{project_id}/fleet-observe/imports": {
      "post": {
        "summary": "Import a batch of principals, credentials and workloads (digests only)",
        "operationId": "project_fleet_observe.create_import",
        "x-asserted-against-backend": true,
        "description": "Accepts up to 5000 members per request (body at most 4 MiB). 201 for a new import, 200 when the idempotency key was already accepted (data.replayed true). Human editor only today; a project-bound API key with fleet_imports:write is planned. Same key with a different request is the planned closed 409; today the API server replays on the key alone.",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^project_(default_[0-9a-f]{16}|personal_[0-9a-f]{32}|[0-9a-f]{32})(?![\\s\\S])",
              "maxLength": 64,
              "x-content-class": "opaque_ref"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./import_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Import accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ImportResponse"
                }
              }
            }
          },
          "200": {
            "description": "Idempotency key already accepted; nothing new stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "Closed validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Closed not found: flag off, API key principal, not a project member of the required role, or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Same idempotency key with a different request (planned; not emitted yet)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Closed internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated (shared authentication layer; not rewritten to 404)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/AuthErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Limiter fail-closed or other masked 5xx",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/RateLimitUnavailableBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited, or the planned project quota",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./fleet_observe_responses_schema.json#/definitions/ImportTooManyRequestsBody"
                }
              }
            }
          }
        }
      }
    },
