{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/fleet_observe/identity_cluster_schema.json",
  "title": "identity_cluster_schema.json",
  "description": "Candidate agent clustered from imported principals, credentials and workloads (F1). The Observe unit stays 'unknown' until clustered. cluster_state 'unknown' means the importer could not group the members into a candidate agent and requires confidence 'unknown'; 'candidate' requires an explicit non-unknown confidence. Short-lived members (24h certificates, short-lived children) join an existing cluster and must not mint a new one: revision counts membership changes of one cluster. agent_ref is null until the cluster is promoted to an agent record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_ref",
    "cluster_state",
    "confidence",
    "members",
    "agent_ref",
    "boundary",
    "first_observed_at",
    "last_observed_at",
    "revision"
  ],
  "properties": {
    "cluster_ref": {
      "$ref": "fleet_observe_common_schema.json#/definitions/ClusterRef"
    },
    "cluster_state": {
      "type": "string",
      "enum": [
        "candidate",
        "unknown"
      ],
      "x-content-class": "closed_enum"
    },
    "confidence": {
      "$ref": "fleet_observe_common_schema.json#/definitions/ConfidenceLevel"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "fleet_observe_common_schema.json#/definitions/ClusterMember"
      }
    },
    "agent_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "fleet_observe_common_schema.json#/definitions/AgentRef"
        }
      ]
    },
    "boundary": {
      "$ref": "fleet_observe_common_schema.json#/definitions/ObservationBoundary"
    },
    "first_observed_at": {
      "$ref": "fleet_observe_common_schema.json#/definitions/Timestamp"
    },
    "last_observed_at": {
      "$ref": "fleet_observe_common_schema.json#/definitions/Timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000,
      "x-content-class": "number"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cluster_state": {
            "const": "unknown"
          }
        },
        "required": [
          "cluster_state"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "const": "unknown"
          },
          "agent_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cluster_state": {
            "const": "candidate"
          }
        },
        "required": [
          "cluster_state"
        ]
      },
      "then": {
        "properties": {
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  ]
}
