{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/mfa/mfa_disable_response_schema.json",
  "title": "MFA Disable Response",
  "description": "200 body for DELETE /api/v1/mfa/disable. Disabling MFA ends every session of the user. An enforced platform admin is forced to re-enroll at next login.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "data"
  ],
  "properties": {
    "success": {
      "const": true
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
