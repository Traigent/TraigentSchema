{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/observability/annotation_queue_update_request_schema.json",
  "title": "Annotation Queue Update Request Schema",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "measure_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "pattern": "\\S"
        }
      }
    },
    {
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "\\S"
        }
      }
    },
    {
      "required": [
        "measure_ids"
      ]
    },
    {
      "required": [
        "status"
      ]
    }
  ]
}
