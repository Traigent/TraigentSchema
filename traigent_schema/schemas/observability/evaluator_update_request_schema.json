{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/observability/evaluator_update_request_schema.json",
  "title": "Evaluator Update Request Schema",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 5000
    },
    "measure_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "target_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "observability_trace",
        "observability_observation",
        "configuration_run",
        "experiment_run",
        null
      ]
    },
    "judge_config": {
      "$ref": "./evaluator_definition_schema.json#/definitions/JudgeConfig"
    },
    "sampling_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "target_filters": {
      "$ref": "./evaluator_definition_schema.json#/definitions/TargetFilters"
    },
    "is_active": {
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "required": [
        "name"
      ]
    },
    {
      "required": [
        "measure_id"
      ]
    },
    {
      "required": [
        "target_type"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "observability_trace",
            "observability_observation",
            "configuration_run",
            "experiment_run"
          ]
        }
      }
    },
    {
      "required": [
        "judge_config"
      ]
    },
    {
      "required": [
        "sampling_rate"
      ]
    },
    {
      "required": [
        "target_filters"
      ]
    },
    {
      "required": [
        "is_active"
      ]
    },
    {
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 5000
        }
      }
    }
  ]
}
