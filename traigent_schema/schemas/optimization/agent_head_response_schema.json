{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/agent_head_response_schema.json",
  "title": "AgentHeadResponse",
  "description": "200 success envelope for the agent head read in the requested environment. Generation 0 with null best_config_id, best_config_version, promoted_by_run_id and updated_at means no configuration has been promoted there. The expected generation is bound to a release acceptance and checked during release. The project comes from the path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "data"
  ],
  "properties": {
    "success": {
      "x-content-class": "closed_enum",
      "const": true
    },
    "message": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "Agent head retrieved successfully"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "environment",
        "generation",
        "best_config_id",
        "best_config_version",
        "promoted_by_run_id",
        "updated_at"
      ],
      "properties": {
        "agent_id": {
          "$ref": "../labels/label_common_schema.json#/definitions/AgentRef",
          "description": "The agent ref of the path, returned unchanged."
        },
        "environment": {
          "$ref": "./session_capabilities_schema.json#/definitions/SessionEnvironment"
        },
        "generation": {
          "x-content-class": "number",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Current head generation; 0 when never promoted. JSON-safe integer bound."
        },
        "best_config_id": {
          "x-content-class": "key_material",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-issued id of the promoted best config; null when never promoted."
        },
        "best_config_version": {
          "x-content-class": "number",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Promoted version; null when never promoted."
        },
        "promoted_by_run_id": {
          "x-content-class": "key_material",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-issued id of the run that promoted the head; null when never promoted."
        },
        "updated_at": {
          "x-content-class": "timestamp",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When the head last moved; null when never promoted."
        }
      }
    }
  }
}
