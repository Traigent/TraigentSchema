{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/best_config_head_refusal_schema.json",
  "title": "BestConfigHeadRefusal",
  "description": "Closed head and reference refusal envelope with fixed error and message text. It retains historical head refusal codes for consumers that read stored responses. The current POST /api/v1/best-configs response contract is declared in execution/best_config_endpoints.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "error",
    "error_code",
    "message"
  ],
  "properties": {
    "success": {
      "x-content-class": "closed_enum",
      "type": "boolean",
      "const": false
    },
    "error": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "reference_not_found",
        "invalid_request",
        "head_precondition_refused",
        "unauthenticated",
        "forbidden",
        "internal_error"
      ],
      "description": "Fixed broad error name for the code."
    },
    "error_code": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "reference_not_found",
        "head_capture_invalid",
        "head_environment_mismatch",
        "head_agent_mismatch",
        "head_generation_stale",
        "head_write_unauthorized",
        "head_body_invalid",
        "head_publish_conflict",
        "unauthenticated",
        "forbidden",
        "internal_error"
      ],
      "description": "Each code has one fixed message. A reference_not_found response masks unknown or inaccessible references. Historical stale-head guidance: the client MUST NOT refresh the generation and resubmit the same result, and the SDK MUST NEVER auto-retry."
    },
    "message": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "Reference not found.",
        "Head capture is missing or malformed.",
        "Environment does not match the session.",
        "Agent does not match the session.",
        "Agent head moved since the capture.",
        "Not authorized to promote this agent.",
        "Publish body is invalid.",
        "Publish conflicts with the current configuration.",
        "Authentication required.",
        "Forbidden.",
        "Internal error."
      ],
      "description": "Fixed text per code, in the order of error_code."
    }
  },
  "oneOf": [
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "reference_not_found"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "reference_not_found"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Reference not found."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "invalid_request"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_capture_invalid"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Head capture is missing or malformed."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "head_precondition_refused"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_environment_mismatch"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Environment does not match the session."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "head_precondition_refused"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_agent_mismatch"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Agent does not match the session."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "head_precondition_refused"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_generation_stale"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Agent head moved since the capture."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "head_precondition_refused"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_write_unauthorized"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Not authorized to promote this agent."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "invalid_request"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_body_invalid"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Publish body is invalid."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "head_precondition_refused"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "head_publish_conflict"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Publish conflicts with the current configuration."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "unauthenticated"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "unauthenticated"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Authentication required."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "forbidden"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "forbidden"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Forbidden."
        }
      }
    },
    {
      "properties": {
        "error": {
          "x-content-class": "closed_enum",
          "const": "internal_error"
        },
        "error_code": {
          "x-content-class": "closed_enum",
          "const": "internal_error"
        },
        "message": {
          "x-content-class": "closed_enum",
          "const": "Internal error."
        }
      }
    }
  ]
}
