{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/best_config_publish_401_schema.json",
  "title": "BestConfigPublish401",
  "description": "The 401 response for best-config publication uses the shared authentication error envelope.",
  "allOf": [
    {
      "$ref": "../error_envelope_schema.json"
    },
    {
      "required": [
        "error_code"
      ],
      "not": {
        "properties": {
          "error_code": {
            "x-content-class": "closed_enum",
            "enum": [
              "reference_not_found",
              "head_capture_invalid",
              "head_environment_mismatch",
              "head_agent_mismatch",
              "head_generation_stale",
              "head_write_unauthorized",
              "head_body_invalid",
              "head_publish_conflict",
              "unauthenticated",
              "forbidden",
              "internal_error"
            ]
          }
        }
      }
    }
  ]
}
