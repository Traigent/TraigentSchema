{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/guarantee_certificate_statistical_body_schema.json",
  "title": "Guarantee Certificate Statistical Body",
  "description": "Reusable statistical and evidence body shared by guarantee-certificate envelopes. Binding and envelope-version fields deliberately do not appear here; each envelope supplies its own binding contract. This fragment intentionally leaves object closure to its composed envelope, because Draft-07 additionalProperties is evaluated within each allOf branch.",
  "type": "object",
  "required": ["mode", "anchor_id", "selected_id", "delta", "epsilon", "epsilon_acc", "epsilon_cost", "eta", "eta_kind", "ci_method", "design", "multiplicity_scheme", "delta_prime_acc", "delta_prime_cost", "per_candidate", "quality_ci", "cost_ci", "sample_count"],
  "properties": {
    "mode": {"$ref": "#/definitions/SelectionMode"},
    "anchor_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "selected_id": {"type": ["string", "null"], "maxLength": 128},
    "delta": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Accuracy non-inferiority margin."},
    "epsilon": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "epsilon_acc": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "epsilon_cost": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "eta": {"type": "number", "minimum": 0},
    "eta_kind": {"type": "string", "enum": ["relative", "absolute", "max_abs_rel"]},
    "ci_method": {"type": "string", "enum": ["empirical_bernstein_fixed", "anytime_valid_confidence_sequence"]},
    "design": {"type": "string", "const": "paired"},
    "multiplicity_scheme": {"type": "string", "enum": ["mode1_2K", "mode2_pairwise_ordered", "mode2_arm_level"]},
    "delta_prime_acc": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "delta_prime_cost": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "per_candidate": {"type": "object", "minProperties": 1, "maxProperties": 4096, "propertyNames": {"type": "string", "maxLength": 128}, "additionalProperties": {"$ref": "#/definitions/CandidateDisposition"}},
    "quality_ci": {"type": "object", "maxProperties": 4096, "additionalProperties": {"$ref": "#/definitions/Interval"}},
    "cost_ci": {"type": "object", "maxProperties": 4096, "additionalProperties": {"$ref": "#/definitions/Interval"}},
    "sample_count": {"type": "object", "maxProperties": 4096, "additionalProperties": {"type": "integer", "minimum": 0}},
    "cost_treated_as": {"type": "string", "enum": ["deterministic", "bounded_stochastic"]},
    "peak_gap_upper_bound": {"type": ["number", "null"], "minimum": 0},
    "composite_gap_to_true_max": {"type": ["number", "null"], "minimum": 0},
    "best_effort_candidate": {"type": ["string", "null"], "maxLength": 128},
    "no_decision_reason": {"type": ["string", "null"], "maxLength": 512},
    "achievable_delta_at_budget": {"type": ["number", "null"], "minimum": 0},
    "extra_examples_for_target_delta": {"type": ["integer", "null"], "minimum": 0},
    "eval_workload_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "candidate_set_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope_notes": {"type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 32}
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "accuracy_then_cost"}}, "required": ["mode"]}, "then": {"required": ["peak_gap_upper_bound", "composite_gap_to_true_max"], "properties": {"peak_gap_upper_bound": {"type": "number", "minimum": 0}, "composite_gap_to_true_max": {"type": "number", "minimum": 0}}}}],
  "definitions": {
    "SelectionMode": {"type": "string", "enum": ["keep_accuracy_reduce_cost", "accuracy_then_cost"]},
    "CandidateDisposition": {"type": "string", "enum": ["selected", "feasible", "infeasible", "undecided", "peak", "anchor"]},
    "Interval": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
  }
}
