        },
        "error_code": {
          "x-content-class": "closed_enum",
          "type": "string",
          "enum": [
            "invalid_request",
            "unauthenticated",
            "forbidden",
            "reference_not_found",
            "acceptance_required",
            "acceptance_expired",
            "acceptance_consumed",
            "acceptance_revoked",
            "acceptance_binding_mismatch",
            "head_generation_stale",
            "rollback_target_not_accepted",
            "internal_error"
          ],
          "description": "Closed refusal code. invalid_request (400); unauthenticated (401); forbidden (403: includes an API key calling the person-only acceptance route, and a key rolling back without authority); reference_not_found (404: project, agent or acceptance unknown, foreign or not visible, indistinguishable); acceptance_required (409: no acceptance supplied or none for this scope); acceptance_expired (409); acceptance_consumed (409: second use); acceptance_revoked (409); acceptance_binding_mismatch (409: the candidate, gate result, configuration space, agent code version, best-config version or environment differs from what was accepted); head_generation_stale (409: the head moved; the caller MUST NOT refresh and resubmit the same acceptance, a new decision is needed); rollback_target_not_accepted (409: the target generation was never accepted or released, or does not exist in the history); internal_error (500). Responses never echo a request value, id, digest or generation."
        },
