{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/optimization/release_acceptance_schema.json",
  "title": "ReleaseAcceptance",
  "description": "Closed contracts for releasing an agent's best config: a person's recorded acceptance of one candidate, the release that consumes it, head rollback, their refusals, and the head-history entry with actor and acceptance. Reviewed closed-contract expansion; every field is a closed enum, a bounded number, a digest, an opaque id or a timestamp, with no free text.",
  "definitions": {
    "AcceptanceId": {
      "x-content-class": "key_material",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Server-issued id of a release acceptance."
    },
    "GateResultDigest": {
      "anyOf": [
        {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest"
        },
        {
          "x-content-class": "closed_enum",
          "type": "string",
          "const": "no_gate_run"
        }
      ],
      "description": "Digest of the promotion-gate result the person saw, or the fixed value `no_gate_run` meaning that no gate was run for this candidate. Required on every acceptance: an absent gate result is stated, never implied by omission. The portal shows `no_gate_run` as such."
    },
    "AgentCodeVersion": {
      "x-content-class": "digest",
      "type": "string",
      "pattern": "^(?:(?:src|tag):)?[0-9a-f]{64}$|^[0-9a-f]{40}$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Digest of the agent code the person accepted: a 40-hex git commit id, or a 64-hex sha256 optionally prefixed 'src:' (SDK digest of the module source) or 'tag:' (SDK digest of a version the user typed; the readable tag stays on the customer side). Bound by the acceptance: a release against different agent code is refused as acceptance_binding_mismatch."
    },
    "ErasableUserRef": {
      "anyOf": [
        {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/UserRef"
        },
        {
          "x-content-class": "key_material",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 128,
          "allOf": [
            {
              "pattern": "^deleted_user_[0-9a-f]{24}(?![\\s\\S])"
            }
          ]
        }
      ],
      "description": "A person who decided: the user UUID, or, after the user was erased, the canonical tombstone `deleted_user_` plus 24 lowercase hex characters that erasure leaves in place of the id. Read models accept both so an erased user's records stay readable."
    },
    "AcceptanceState": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "accepted",
        "consumed",
        "revoked"
      ],
      "description": "Lifecycle of an acceptance. accepted -> consumed (by exactly one release) or accepted -> revoked. consumed and revoked are final."
    },
    "ActorKind": {
      "x-content-class": "closed_enum",
      "type": "string",
      "enum": [
        "user",
        "service_principal"
      ],
      "description": "Who moved a head: a person (`user`) or a key or service identity (`service_principal`)."
    },
    "CreateReleaseAcceptanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "best_config_id",
        "best_config_version",
        "candidate_fingerprint",
        "gate_result_digest",
        "configuration_space_digest",
        "agent_code_version",
        "expected_head_generation"
      ],
      "properties": {
        "environment": {
          "$ref": "./session_capabilities_schema.json#/definitions/SessionEnvironment"
        },
        "best_config_id": {
          "x-content-class": "key_material",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-issued id of the best config the person accepts."
        },
        "best_config_version": {
          "x-content-class": "number",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Exact best-config version accepted."
        },
        "candidate_fingerprint": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest",
          "description": "Fingerprint of the candidate configuration (lowercase-hex sha256 of the TVL canonical JSON, the convention of the reactive grant)."
        },
        "gate_result_digest": {
          "$ref": "./release_acceptance_schema.json#/definitions/GateResultDigest"
        },
        "configuration_space_digest": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Digest",
          "description": "Digest of the configuration space the candidate was chosen from."
        },
        "agent_code_version": {
          "$ref": "./release_acceptance_schema.json#/definitions/AgentCodeVersion"
        },
        "expected_head_generation": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Generation",
          "description": "Head generation the person saw when accepting. A release is refused as head_generation_stale if the head has moved."
        }
      },
      "description": "Body of POST /api/v1/projects/{project_id}/agents/{agent_ref}/release-acceptances. A person's decision to release one exact candidate; person only (an API key is refused). The server binds these fields immutably, stamps the decider from the authenticated person and sets the expiry from its own clock. Every field is required; there is no free text."
    },
