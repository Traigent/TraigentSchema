        "gate_result_digest",
        "configuration_space_digest",
        "agent_code_version",
        "expected_head_generation",
        "decided_by_user_id",
        "decided_at",
        "expires_at",
        "state",
        "consumed_at",
        "consumed_generation",
        "revoked_at"
      ],
      "properties": {
        "id": {
          "$ref": "./release_acceptance_schema.json#/definitions/AcceptanceId"
        },
        "agent_id": {
          "$ref": "../labels/label_common_schema.json#/definitions/AgentRef",
