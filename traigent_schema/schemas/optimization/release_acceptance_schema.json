        },
        "decided_by_user_id": {
          "$ref": "./release_acceptance_schema.json#/definitions/ErasableUserRef"
        },
        "decided_at": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Timestamp",
          "description": "Server time of the decision."
        },
        "expires_at": {
          "$ref": "./tvl_reactive_common_schema.json#/definitions/Timestamp",
          "description": "Server-set expiry; a release after it is refused as acceptance_expired."
        },
        "state": {
          "$ref": "./release_acceptance_schema.json#/definitions/AcceptanceState"
        },
        "consumed_at": {
          "x-content-class": "timestamp",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 40,
          "description": "When the acceptance was consumed by a release; null unless state is consumed."
        },
        "consumed_generation": {
          "x-content-class": "number",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Head generation the consuming release produced; null unless state is consumed."
        },
        "revoked_at": {
          "x-content-class": "timestamp",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 40,
          "description": "When the acceptance was revoked; null unless state is revoked."
        }
      },
      "description": "Stored acceptance record: the receipt of POST .../release-acceptances and the read model of GET. Only the lifecycle members (state, consumed_at, consumed_generation, revoked_at) change after creation. Lifecycle consistency: accepted has all three null; consumed has consumed_at and consumed_generation and no revoked_at; revoked has revoked_at and neither consumed member.",
      "oneOf": [
        {
          "properties": {
            "state": {
              "x-content-class": "closed_enum",
              "const": "accepted"
            },
            "consumed_at": {
              "x-content-class": "timestamp",
              "type": "null"
            },
            "consumed_generation": {
              "x-content-class": "number",
              "type": "null"
            },
            "revoked_at": {
              "x-content-class": "timestamp",
              "type": "null"
            }
          }
        },
        {
          "properties": {
