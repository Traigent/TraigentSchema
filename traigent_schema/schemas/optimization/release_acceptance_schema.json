              "const": "consumed"
            },
            "consumed_at": {
              "x-content-class": "timestamp",
              "type": "string",
              "format": "date-time"
            },
            "consumed_generation": {
              "x-content-class": "number",
              "type": "integer"
            },
            "revoked_at": {
              "x-content-class": "timestamp",
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "state": {
              "x-content-class": "closed_enum",
              "const": "revoked"
            },
            "consumed_at": {
              "x-content-class": "timestamp",
              "type": "null"
            },
            "consumed_generation": {
              "x-content-class": "number",
              "type": "null"
            },
            "revoked_at": {
              "x-content-class": "timestamp",
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
