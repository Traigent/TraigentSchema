          {
            "name": "agent_ref",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../labels/label_common_schema.json#/definitions/AgentRef"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "description": "Closed run environment; absent means every environment.",
            "schema": {
              "$ref": "./session_capabilities_schema.json#/definitions/SessionEnvironment"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items, default 50.",
            "schema": {
              "x-content-class": "number",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
