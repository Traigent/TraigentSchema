                }
              }
            }
          },
          "401": {
            "description": "unauthenticated. Closed envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./release_acceptance_schema.json#/definitions/ReleaseRefusal"
                }
              }
            }
          },
          "403": {
            "description": "forbidden. Closed envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./release_acceptance_schema.json#/definitions/ReleaseRefusal"
                }
              }
            }
          },
          "404": {
            "description": "reference_not_found. Closed envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./release_acceptance_schema.json#/definitions/ReleaseRefusal"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          },
          "500": {
            "description": "internal_error. Closed envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./release_acceptance_schema.json#/definitions/ReleaseRefusal"
                }
              }
            }
          }
        }
      }
