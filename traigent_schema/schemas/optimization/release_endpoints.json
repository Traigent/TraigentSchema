  "info": {
    "title": "Traigent Release Candidate, Acceptance and Head Rollback Routes",
    "version": "1.0.0",
    "description": "Project-scoped routes for reporting release candidates, recording acceptance, releasing an accepted candidate and rolling back the agent promotion head. Planned routes with closed wire contracts."
