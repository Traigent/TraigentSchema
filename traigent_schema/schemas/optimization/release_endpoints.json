    "/api/v1/projects/{project_id}/agents/{agent_ref}/best-config-head/release": {
      "post": {
        "summary": "Release an accepted candidate: move the agent head",
        "description": "TraigentBackend (planned). Editor with agent WRITE, including an SDK API key: the person's decision is the acceptance. One transaction locks the head, rechecks the acceptance and moves the head, then marks the acceptance consumed. A refused call moves no head. Every error body is the closed envelope release_acceptance_schema.json#/definitions/ReleaseRefusal except 429.",
        "operationId": "best_configs.release_agent_head",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "x-content-class": "key_material",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 1,
              "maxLength": 128,
