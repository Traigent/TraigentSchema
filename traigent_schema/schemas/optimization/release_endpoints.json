      "post": {
        "summary": "Roll the agent head back to an earlier accepted generation",
        "description": "Person only: an API key or service token is refused 403 forbidden. The target must be a generation that was already accepted or released, and the request carries a fresh release acceptance (recorded by a person through the release-acceptances route, bound to the target's pinned config) that the rollback consumes, exactly as a release consumes its own. The move is a new head generation with the actor and the consumed acceptance recorded. Every error body is the closed envelope release_acceptance_schema.json#/definitions/ReleaseRefusal except 429.",
        "operationId": "best_configs.rollback_agent_head",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "x-content-class": "key_material",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 1,
              "maxLength": 128,
