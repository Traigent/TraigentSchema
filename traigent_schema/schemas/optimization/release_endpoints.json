        "operationId": "best_configs.list_release_acceptances",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "x-content-class": "key_material",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "minLength": 1,
              "maxLength": 128,
              "description": "Server-issued project id."
            }
