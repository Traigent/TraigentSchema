{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Planned Project Contracts",
    "version": "1.0.0",
    "description": "Compatibility catalog for planned and mixed-maturity contract surfaces. Operation-scoped assertion metadata is authoritative for modules that contain both implemented and contract-first routes."
  },
  "x-traigent-contract": {
    "name": "planned_projects",
    "status": "planned",
    "description": "Compatibility root for project-scoped v1beta and experimental routes. It also indexes the mixed-maturity economics module: telemetry is implemented and asserted at operation scope, while recommendation remains contract-first and unasserted. Operation metadata in a mixed module, rather than this root's fallback classification, is authoritative."
  },
  "x-stability": "pre-release",
  "x-asserted-against-backend": false,
  "x-endpoint-modules": [
    {
      "name": "prompt_management",
      "paths_file": "./prompts/prompts_endpoints.json"
    },
    {
      "name": "observability",
      "paths_file": "./observability/observability_endpoints.json"
    },
    {
      "name": "economics_telemetry",
      "description": "Mixed-maturity economics routes: telemetry ingestion (exposure funnel, run economics, receipts) is implemented and asserted at operation scope; recommendation remains contract-first and unasserted.",
      "paths_file": "./economics/economics_endpoints.json"
    }
  ],
