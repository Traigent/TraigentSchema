{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.traigent.ai/projects/project_scoped_experiment_trend_schema.json",
  "type": "object",
  "title": "Project Scoped Experiment Trend Schema",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string"
    },
    "experiment_name": {
      "type": "string"
    },
    "runs_total": {
      "type": "integer",
      "minimum": 0
    },
    "configuration_runs_total": {
      "type": "integer",
      "minimum": 0
    },
    "daily_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "count"
        ]
      },
      "maxItems": 366
    },
    "daily_configuration_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "count"
        ]
      },
      "maxItems": 366
    },
    "measure_summary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "mean": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "count",
          "mean",
          "min",
          "max"
        ]
      },
      "maxProperties": 200
    },
    "experiment_ref": {
      "$ref": "../evaluation/experiment_reads_schema.json#/definitions/ExperimentRef",
      "description": "The experiment's server-minted reference, echoed from the request path. The historical experiment id is not returned."
    }
  },
  "required": [
    "project_id",
    "experiment_ref",
    "experiment_name",
    "runs_total",
    "configuration_runs_total",
    "daily_runs",
    "daily_configuration_runs",
    "measure_summary"
  ],
  "x-max-response-bytes": 1048576,
  "description": "Run and configuration-run trend of one experiment, addressed by experiment_ref (project_core_metrics.get_experiment_trend). Bounded by new canonical-operation budgets that the backend window-1b cutover will enforce (not existing backend behaviour): at most 366 daily points per series, the most recent 366 dates when the experiment has more, at most 200 measure summaries and 1048576 serialized bytes."
}
