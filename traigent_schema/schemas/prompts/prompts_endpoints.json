  "components": {
    "schemas": {
      "PromptAnalytics": {
        "type": "object",
        "description": "Per-version metrics plus one cursor page of the newest observability links.",
        "required": [
          "prompt_id",
          "prompt_name",
          "prompt_type",
          "totals",
          "versions",
          "recent_links",
          "recent_links_pagination"
        ],
        "additionalProperties": true,
        "properties": {
          "prompt_id": {
            "type": "string",
            "description": "The prompt_ref."
          },
          "prompt_name": {
            "type": "string",
            "maxLength": 255
          },
          "prompt_type": {
            "enum": [
              "text",
              "chat"
            ]
          },
          "totals": {
            "type": "object",
            "additionalProperties": true
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "version"
              ],
              "additionalProperties": true,
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "recent_links": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "recent_links_pagination": {
            "$ref": "#/components/schemas/PromptsPagination"
          }
        }
      },
      "PromptAnalyticsEnvelope": {
        "type": "object",
        "description": "Success envelope around prompt analytics.",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PromptAnalytics"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PromptDetailEnvelope": {
        "type": "object",
        "description": "Success envelope around a prompt with its versions.",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "./prompt_detail_schema.json"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PromptPageEnvelope": {
        "type": "object",
        "description": "Success envelope around one cursor page of prompt summaries.",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PromptsPage"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PromptPlaygroundEnvelope": {
        "type": "object",
        "description": "Success envelope around a playground run.",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "./prompt_playground_result_schema.json"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PromptSearchRequest": {
        "type": "object",
        "description": "Search body. The terms are customer text, so they never appear in a URL (API-R5).",
        "additionalProperties": false,
        "properties": {
          "search": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Matches the prompt name or description."
          },
          "prompt_type": {
            "enum": [
              "text",
              "chat",
              null
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "sort_by": {
            "enum": [
              "updated_at",
              "name",
              "version_count"
            ],
            "default": "updated_at",
            "description": "Sort key. A cursor is bound to the sort: using it with another sort is a 400 invalid_cursor problem."
          },
          "sort_order": {
            "enum": [
              "asc",
              "desc",
              null
            ],
            "description": "Null means the key's default: desc for updated_at and version_count, asc for name."
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100,
            "description": "Default 20. Above 100 is rejected with a 400 problem, never clamped."
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          }
        }
      },
      "PromptsPage": {
        "type": "object",
        "required": [
          "items",
          "pagination"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "./prompt_summary_schema.json"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PromptsPagination"
          }
        }
      },
      "PromptsPagination": {
        "type": "object",
        "description": "Cursor pagination (API-R13): the cursor is opaque and bound to scope, filter and sort.",
        "required": [
          "limit",
          "next_cursor",
          "has_more"
        ],
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "PromptsProblem": {
        "type": "object",
        "description": "RFC 9457 problem document. Closed vocabulary: nothing the client sent is echoed.",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "problem_id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "maxLength": 128
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "detail": {
            "type": "string",
            "maxLength": 256
          },
          "problem_id": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "ResolvedPromptEnvelope": {
        "type": "object",
        "description": "Success envelope around one resolved prompt version.",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "./resolved_prompt_schema.json"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PromptResolveRequest": {
        "type": "object",
        "description": "Resolve body. The label is customer-chosen text, so it never appears in a URL (API-R5). An empty body resolves label latest.",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64,
            "description": "A label name (default latest)."
          }
        }
      }
    },
    "responses": {
      "PromptsBadRequest": {
        "description": "invalid_page_size or invalid_cursor",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsConflict": {
        "description": "prompt_already_exists or prompt_version_conflict",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsForbidden": {
        "description": "feature_not_entitled or provider_not_allowed: the caller is a member but the plan or policy does not allow it",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsNotFound": {
        "description": "The closed 404: missing, foreign, or a project the caller is not a member of. Identical in every case",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsPaymentRequired": {
        "description": "insufficient_balance or spend_blocked",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsUnauthenticated": {
        "description": "Authentication is required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsUpstreamFailed": {
        "description": "upstream_failed: the model call failed",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      },
      "PromptsValidationFailed": {
        "description": "validation_failed: the request is not valid; nothing is echoed",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/PromptsProblem"
            }
          }
        }
      }
    }
  }
}
