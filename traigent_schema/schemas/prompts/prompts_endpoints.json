{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Prompt Management Routes",
    "version": "2.0.0",
    "description": "Project-scoped prompt management: server-minted prompt_ref paths, POST search and resolve (customer text stays out of URLs), cursor pagination, problem+json errors. Replaces the retired planned /api/v1beta prompts routes."
  },
  "paths": {
    "/api/v1/projects/{project_id}/prompts": {
      "get": {
        "operationId": "prompt_management.list_prompts",
        "summary": "List the project's prompts, newest update first",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size: default 20, maximum 100; above 100 is rejected with a 400 problem, never clamped.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from a previous page.",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "prompt_type",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "text",
                "chat"
              ]
            }
          }
        ],
        "description": "Cursor pagination (API-R13). The query string carries only bounded pagination and the closed prompt_type enum; to filter by name, label or text use prompt_management.search_prompts.",
        "responses": {
          "200": {
            "description": "One page of prompts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptPageEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PromptsBadRequest"
          },
          "422": {
            "$ref": "#/components/responses/PromptsValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "prompt_management.create_prompt",
        "summary": "Create a prompt with its first version; the response carries its server-minted id",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "description": "The name is a body field, unique per project (and owner in the shared default tenant). The returned id is the prompt_ref used in every other path.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./prompt_create_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created prompt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptDetailEnvelope"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/PromptsForbidden"
          },
          "409": {
            "$ref": "#/components/responses/PromptsConflict"
          },
          "422": {
            "$ref": "#/components/responses/PromptsValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/prompts/search": {
      "post": {
        "operationId": "prompt_management.search_prompts",
        "summary": "Search the project's prompts by name, text or label",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "description": "A read served as POST so that customer-chosen search terms stay out of URLs, access logs and traces (API-R5). Same page shape and caps as list; the cursor is bound to the filters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One page of matching prompts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptPageEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PromptsBadRequest"
          },
          "422": {
            "$ref": "#/components/responses/PromptsValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/prompts/{prompt_ref}": {
      "get": {
        "operationId": "prompt_management.get_prompt",
        "summary": "Get one prompt with its versions",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "prompt_ref",
            "in": "path",
            "required": true,
            "description": "Server-minted, opaque, stable id of the prompt definition (the id returned by create and list). Never derived from the name.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The prompt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptDetailEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "prompt_management.delete_prompt",
        "summary": "Delete a prompt and all its versions and labels",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "prompt_ref",
            "in": "path",
            "required": true,
            "description": "Server-minted, opaque, stable id of the prompt definition (the id returned by create and list). Never derived from the name.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; no body"
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/prompts/{prompt_ref}/analytics": {
      "get": {
        "operationId": "prompt_management.get_prompt_analytics",
        "summary": "Usage analytics of one prompt, with a cursor page of recent links",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "prompt_ref",
            "in": "path",
            "required": true,
            "description": "Server-minted, opaque, stable id of the prompt definition (the id returned by create and list). Never derived from the name.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size: default 20, maximum 100; above 100 is rejected with a 400 problem, never clamped.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from a previous page.",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          }
        ],
        "description": "recent_links is paged by cursor (newest first), replacing the former recent_limit/recent_page offsets (API-R13).",
        "responses": {
          "200": {
            "description": "Analytics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptAnalyticsEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PromptsBadRequest"
          },
          "422": {
            "$ref": "#/components/responses/PromptsValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/prompts/{prompt_ref}/resolve": {
      "post": {
        "operationId": "prompt_management.resolve_prompt",
        "summary": "Resolve one version by number or by label",
        "x-asserted-against-backend": false,
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "prompt_ref",
            "in": "path",
            "required": true,
            "description": "Server-minted, opaque, stable id of the prompt definition (the id returned by create and list). Never derived from the name.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "description": "A read served as POST so that the label (customer-chosen text) stays out of URLs, access logs and traces (API-R5). Nothing is written. Unknown body fields are rejected with the closed validation error.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The resolved version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolvedPromptEnvelope"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/PromptsValidationFailed"
          },
          "401": {
            "$ref": "#/components/responses/PromptsUnauthenticated"
          },
          "404": {
            "$ref": "#/components/responses/PromptsNotFound"
          },
          "429": {
            "description": "Too many requests \u2014 rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/prompts/{prompt_ref}/versions": {
      "post": {
        "operationId": "prompt_management.create_prompt_version",
