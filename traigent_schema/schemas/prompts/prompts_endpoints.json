{
  "openapi": "3.0.0",
  "info": {
    "title": "Traigent Prompt Management Beta Routes",
    "version": "1.0.0",
    "description": "Planned project-scoped and tenant-scoped prompt management and playground routes used by the beta SDK surface."
  },
  "paths": {
    "/api/v1beta/prompts": {
      "get": {
        "summary": "List prompts",
        "operationId": "listPrompts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "prompt_type",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["text", "chat"] }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["updated_at", "name", "version_count"], "default": "updated_at" }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "description": "Sort direction. When omitted the default depends on sort_by: desc for updated_at and version_count, asc for name.",
            "schema": { "type": "string", "enum": ["asc", "desc"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Prompts retrieved successfully"
          },
          "422": {
            "description": "Invalid query parameter value."
          },
          "429": {
            "description": "Too many requests — rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create prompt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./prompt_create_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Prompt created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./prompt_detail_schema.json"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests — rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../rate_limit_info_schema.json"
                }
              }
            }
          }
        }
      }
    },
