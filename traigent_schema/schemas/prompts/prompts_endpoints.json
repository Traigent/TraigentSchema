            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./prompt_version_create_request_schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The prompt with the new version",
